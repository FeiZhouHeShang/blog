					"</div>" +
					'<div class="mg-form-field mg-form-full">' +
						'<label>悬停评语</label>' +
						'<textarea class="mg-editor-textarea" data-f="comment" placeholder="一句话感想">' + escHtml(item.comment || "") + "</textarea>" +
					"</div>" +
					'<div class="mg-form-actions">' +
