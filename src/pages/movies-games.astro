---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LeftSidebar from "@/components/layout/LeftSidebar.astro";
import RightSidebar from "@/components/layout/RightSidebar.astro";
import { moviesGames, type MediaItem, type MediaSection, type MediaStatus } from "@/data/movies-games";
import { editorSecrets } from "@/config/editorSecrets";
import fs from "node:fs";
import path from "node:path";

// 读取源文件原文，作为「存本地」序列化模板（无需先拉远端，避免冲掉已有条目）
const mgSourceRaw = (() => {
	try {
		return fs.readFileSync(path.resolve(process.cwd(), "src/data/movies-games.ts"), "utf-8");
	} catch (e) {
		return "";
	}
})();

// 影视与游戏页（Bangumi 风格收藏墙）
// 数据来源：src/data/movies-games.ts
// 编辑方式：页面底部「在 GitHub 编辑」按钮 → 直达该文件的 GitHub 网页编辑器（零后端）
const title = "影视与游戏";
const description = "我的影视与游戏收藏记录";

// —— 类型 Tab ——
const sections: { key: MediaSection | "all"; label: string }[] = [
	{ key: "all", label: "全部" },
	{ key: "movie", label: "电影" },
	{ key: "tv", label: "电视剧" },
	{ key: "anime", label: "动漫" },
	{ key: "documentary", label: "纪录片" },
	{ key: "game", label: "游戏" },
];
// —— 状态筛选 ——
const statuses: { key: MediaStatus | "all"; label: string }[] = [
	{ key: "all", label: "全部" },
	{ key: "collect", label: "看过" },
	{ key: "doing", label: "在看" },
	{ key: "wish", label: "想看" },
	{ key: "on_hold", label: "搁置" },
	{ key: "dropped", label: "抛弃" },
];

const sectionCount = (k: MediaSection | "all") =>
	k === "all" ? moviesGames.length : moviesGames.filter((m) => m.section === k).length;
const statusCount = (k: MediaStatus | "all") =>
	k === "all" ? moviesGames.length : moviesGames.filter((m) => m.status === k).length;

// 状态 → 中文标签（游戏「在看」写作「在玩」）
const STATUS_LABEL: Record<MediaStatus, string> = {
	collect: "看过",
	doing: "在看",
	wish: "想看",
	on_hold: "搁置",
	dropped: "抛弃",
};
// 状态 → 配色（Tailwind 工具类，字面量出现于本文件，Tailwind 会扫描生成）
const STATUS_COLOR: Record<MediaStatus, string> = {
	collect: "bg-emerald-500/80",
	doing: "bg-amber-500/80",
	wish: "bg-sky-500/80",
	on_hold: "bg-violet-500/80",
	dropped: "bg-rose-400/80",
};
function statusLabel(item: MediaItem): string {
	if (item.section === "game" && item.status === "doing") return "在玩";
	return STATUS_LABEL[item.status];
}

/**
 * 编辑方式（双通道）：
 *  1) 页面顶部「✏️ 编辑列表」按钮 → 弹出管理面板，可在前端增/删/改条目
 *     输入 GitHub PAT 后点保存 → 浏览器直接调 GitHub Contents API
 *     (GET 拿 sha → 替换数组字面量 → base64 → PUT)
 *     PAT 仅存浏览器 localStorage，零后端。
 *  2) 「在 GitHub 编辑」按钮 → 跳到 GitHub 网页编辑器（不熟 API 时用）
 */

// GitHub 编辑回链（与 git remote 对齐：FeiZhouHeShang/blog @ main）
const EDIT_URL =
	"https://github.com/FeiZhouHeShang/blog/edit/main/src/data/movies-games.ts";
// GitHub Contents API（前端编辑器用）
const API_FILE_URL =
	"https://api.github.com/repos/FeiZhouHeShang/blog/contents/src/data/movies-games.ts?ref=main";
const COMMIT_URL_BASE = "https://github.com/FeiZhouHeShang/blog/commits/main/src/data/movies-games.ts";
// 推荐用 fine-grained PAT，只勾 Contents: Read and write for this repo
const PAT_HELP_URL =
	"https://github.com/settings/personal-access-tokens/new?description=movies-games-editor&contents=write";

const STAR_PATH =
	"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z";
---

<MainGridLayout title={title} description={description}>
	<LeftSidebar slot="sidebar-left" />
	<RightSidebar slot="sidebar-right" />

	<div class="mg-page-wrapper w-full rounded-(--radius-large) overflow-hidden relative min-h-32" id="mg-root">
		<!-- 头部：标题 + 编辑按钮组 -->
		<div class="mg-header relative w-full mb-8 flex flex-wrap items-end justify-between gap-4">
			<div>
				<h1 class="text-2xl font-bold tracking-tight text-[var(--deep-text)]">影视与游戏</h1>
				<p class="mt-1 text-sm text-[var(--content-meta)]">
					共 {moviesGames.length} 部 · 看完的、在追的、想看的，都在这
				</p>
			</div>
			<div class="flex items-center gap-2">
				<button
					type="button"
					id="mg-open-editor"
					class="btn-card inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm hover:shadow-md transition-all duration-150"
					title="在网页上直接增删改影视/游戏记录，输入 GitHub PAT 即可保存到 GitHub"
				>
					<svg width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
					</svg>
					编辑列表
				</button>
				<a
					href={EDIT_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-card inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-sm font-medium text-[var(--primary)] hover:bg-[var(--btn-card-bg-hover)] transition-all duration-150"
					title="GitHub 网页编辑器（不熟 API 时用）"
				>
					<svg width="1.05em" height="1.05em" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
				</a>
			</div>
		</div>

		<!-- 类型 Tab -->
		<div class="mg-tabs-wrapper mb-6">
			<div class="tools-tab-pill" data-mg-type-pill="">
				<span class="tools-tab-indicator" data-mg-indicator=""></span>
				{
					sections.map((s, i) => (
						<button
							type="button"
							class:list={["tools-tab-btn", i === 0 ? "tools-tab-btn-active" : "tools-tab-btn-inactive"]}
							data-tab={s.key}
						>
							<span>{s.label}</span>
							<span class="tools-tab-badge">{sectionCount(s.key)}</span>
						</button>
					))
				}
			</div>
		</div>

		<!-- 状态筛选 -->
		<div class="mg-filter-wrapper tools-tab-pill mb-5" data-mg-filter-pill="">
			<span class="tools-tab-indicator" data-mg-indicator=""></span>
			{
				statuses.map((s, i) => (
					<button
						type="button"
						class:list={["tools-tab-btn", "mg-filter-btn", i === 0 ? "tools-tab-btn-active" : "tools-tab-btn-inactive"]}
						data-filter={s.key}
					>
						<span>{s.label}</span>
						<span class="tools-tab-badge">{statusCount(s.key)}</span>
					</button>
				))
			}
		</div>

		<!-- 卡片网格 -->
		<div class="mg-grid grid grid-cols-3 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-5" data-mg-grid="">
			{
				moviesGames.map((item) => (
					<div class="mg-item" data-section={item.section} data-status={item.status} data-has-url={item.bangumiUrl ? "1" : "0"}>
						<a
							href={item.bangumiUrl || "javascript:void(0)"}
							class="mg-card group"
							data-ext-bangumi={item.bangumiUrl ? "1" : "0"}
							target={item.bangumiUrl ? "_blank" : undefined}
							rel={item.bangumiUrl ? "noopener noreferrer" : undefined}
						>
							<div class="mg-cover">
								{item.cover ? (
									<img
										src={item.cover}
										alt={item.title}
										class="mg-img"
										loading="lazy"
										onerror="this.style.display='none'"
									/>
								) : (
									<div class="mg-img mg-img-placeholder">{item.title.charAt(0)}</div>
								)}
								<div class="mg-gradient"></div>
								<span class:list={["mg-status", STATUS_COLOR[item.status]]}>{statusLabel(item)}</span>
							</div>
							<div class="mg-info">
								<h3 class="mg-title">{item.title}</h3>
								{item.tags && item.tags.length > 0 && (
									<div class="mg-tags">
										{item.tags.map((t) => (
											<span class="mg-tag">{t}</span>
										))}
									</div>
								)}
							</div>
							{item.comment && (
								<div class="mg-overlay">
									<p class="mg-comment">{item.comment}</p>
								</div>
							)}
						</a>
					</div>
				))
			}
		</div>

		<!-- 空状态 -->
		<div class="mg-empty py-16 text-center text-[var(--content-meta)]" data-mg-empty="" style="display:none;">
			这个分类下还没有记录～
		</div>

		<!-- 分页 -->
		<div
			class="bangumi-pagination responsive-pagination flex flex-wrap justify-center items-center gap-2 mt-8"
			data-mg-pagination=""
		>
		</div>

		<!-- ========== 前端编辑器模态框 ========== -->
		<!-- 用 <dialog> 原生元素 + is:global 样式（动态注入的 innerHTML 走 [data-mg-editor] 限定） -->
		<dialog
			id="mg-editor"
			data-mg-editor=""
			class="mg-editor-dialog"
			data-tmdb-default={editorSecrets.tmdbApiToken}
			data-gh-default={editorSecrets.githubPat}
		>
			<div class="mg-editor-panel">
				<!-- 头部 -->
				<header class="mg-editor-head">
					<div>
						<h2 class="mg-editor-title">编辑影视/游戏列表</h2>
						<p class="mg-editor-sub">编辑实时存入本地草稿；最后在右下角「上传中心」统一推送（所有改动合并为 1 次提交）</p>
					</div>
					<button type="button" id="mg-editor-close" class="mg-editor-close" aria-label="关闭">×</button>
				</header>

				<!-- Token 区 -->
				<section class="mg-editor-token">
					<label class="mg-editor-label">
						<span>GitHub Personal Access Token</span>
						<span class="mg-editor-label-tip">
							仅存浏览器 localStorage
							· <a href={PAT_HELP_URL} target="_blank" rel="noopener noreferrer" class="mg-editor-link">生成 fine-grained PAT</a>
						</span>
					</label>
					<div class="mg-editor-token-row">
						<input
							type="password"
							id="mg-editor-pat"
							placeholder="github_pat_xxxxxxxxxxxxxx"
							autocomplete="off"
							spellcheck="false"
							class="mg-editor-input"
						/>
						<button type="button" id="mg-editor-pat-toggle" class="mg-editor-mini" title="显示/隐藏">👁</button>
						<button type="button" id="mg-editor-pat-clear" class="mg-editor-mini mg-editor-mini-danger" title="清除本地保存的 Token">🗑</button>
						<button type="button" id="mg-editor-load" class="mg-editor-btn mg-editor-btn-secondary">🔄 加载远端</button>
					</div>
					<p id="mg-editor-status" class="mg-editor-status">未加载远端数据</p>
					<!-- TMDB 智能匹配：使用烘焙的只读令牌（src/config/editorSecrets.ts），前端无任何 key 输入入口 -->
				</section>

				<!-- 工具条 -->
				<section class="mg-editor-toolbar">
					<button type="button" id="mg-editor-add" class="mg-editor-btn mg-editor-btn-primary">+ 新增条目</button>
					<span class="mg-editor-count">共 <span id="mg-editor-count">0</span> 条</span>
				</section>

				<!-- 条目列表 -->
				<section id="mg-editor-list" class="mg-editor-list"></section>

				<!-- 底部操作 -->
				<footer class="mg-editor-foot">
					<p id="mg-editor-foot-status" class="mg-editor-foot-status">准备就绪</p>
					<div class="mg-editor-foot-actions">
						<a id="mg-editor-commits" href={COMMIT_URL_BASE} target="_blank" rel="noopener noreferrer" class="mg-editor-link" style="display:none;">查看提交历史</a>
						<button type="button" id="mg-editor-cancel" class="mg-editor-btn">关闭</button>
						<button type="button" id="mg-editor-save" class="mg-editor-btn mg-editor-btn-primary">💾 存本地</button>
					</div>
				</footer>

				<!-- 待上传：本地草稿 -->
				<section class="mg-editor-drafts">
					<div class="mg-drafts-head">
						<span>🗂 待上传（本地草稿）</span>
						<span class="mg-editor-label-tip">真正推送仓库请用右下角「上传中心」</span>
					</div>
					<div id="mg-draft-panel" class="mg-draft-panel"></div>
				</section>
			</div>
		</dialog>
		<!-- ========== /前端编辑器模态框 ========== -->
	</div>
</MainGridLayout>

<style>
	/* mg-* 自定义样式（卡片为 SSR 渲染，scoped 生效） */
	.mg-card {
		position: relative;
		display: block;
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--float-panel-bg);
		border: 1px solid var(--line-divider);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
		transition:
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.25s ease;
	}
	.mg-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
	}
	/* 无 bangumiUrl 的卡片：不能跳，hover 也不抬升 */
	.mg-item[data-has-url="0"] .mg-card {
		cursor: not-allowed;
	}
	.mg-item[data-has-url="0"] .mg-card:hover {
		transform: none;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
	}
	.mg-item[data-has-url="0"] .mg-img {
		filter: grayscale(0.2);
		opacity: 0.85;
	}
	.mg-cover {
		position: relative;
		aspect-ratio: 2 / 3;
		overflow: hidden;
		background: linear-gradient(135deg, var(--primary) 0%, var(--deep-text) 100%);
	}
	.mg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}
	.mg-card:hover .mg-img {
		transform: scale(1.06);
	}
	.mg-img-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.85);
	}
	.mg-gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 45%);
		pointer-events: none;
	}
	.mg-status {
		position: absolute;
		top: 0.4rem;
		left: 0.4rem;
		padding: 0.1rem 0.45rem;
		font-size: 0.7rem;
		font-weight: 600;
		color: #fff;
		border-radius: 0.4rem;
		backdrop-filter: blur(2px);
	}
	.mg-info {
		padding: 0.5rem 0.6rem 0.6rem;
	}
	.mg-title {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--deep-text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.mg-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 0.3rem;
	}
	.mg-tag {
		font-size: 0.65rem;
		padding: 0.05rem 0.35rem;
		border-radius: 0.3rem;
		color: var(--content-meta);
		background: var(--btn-card-bg-hover);
	}
	/* 悬停评语浮层 */
	.mg-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		padding: 0.75rem;
		background: rgba(0, 0, 0, 0.72);
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
	}
	.mg-card:hover .mg-overlay {
		opacity: 1;
	}
	.mg-comment {
		font-size: 0.75rem;
		line-height: 1.4;
		color: #fff;
	}

	/* 自带 indicator（独立于 collections.css 的，避免冲突） */
	[data-mg-indicator] {
		opacity: 1 !important;
	}
</style>

<style is:global>
	/* ===== 前端编辑器模态框 =====
	 * 用 [data-mg-editor] 限定作用域，确保动态 innerHTML 注入的元素也能命中。
	 * 若用 <style scoped> + :global(.mg-editor-xxx)，Astro 会把作用域属性加在静态元素上，
	 * 动态元素无该属性 → 整条规则失效（天气组件踩过同款坑）。
	 */
	[data-mg-editor].mg-editor-dialog {
		border: none;
		padding: 0;
		background: transparent;
		max-width: 100vw;
		max-height: 100vh;
		width: 100%;
		height: 100%;
		margin: 0;
		inset: 0;
	}
	[data-mg-editor].mg-editor-dialog::backdrop {
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(4px);
	}
	[data-mg-editor] .mg-editor-panel {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: min(960px, 96vw);
		max-height: 92vh;
		background: var(--float-panel-bg, #fff);
		color: var(--deep-text, #222);
		border-radius: 1rem;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	[data-mg-editor] .mg-editor-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--line-divider, #e5e7eb);
	}
	[data-mg-editor] .mg-editor-title {
		font-size: 1.05rem;
		font-weight: 700;
		margin: 0;
	}
	[data-mg-editor] .mg-editor-sub {
		font-size: 0.75rem;
		color: var(--content-meta, #6b7280);
		margin: 0.15rem 0 0;
	}
	[data-mg-editor] .mg-editor-close {
		background: transparent;
		border: none;
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
		color: var(--content-meta, #6b7280);
		padding: 0.25rem 0.5rem;
		border-radius: 0.4rem;
		transition: background 0.15s;
	}
	[data-mg-editor] .mg-editor-close:hover {
		background: var(--btn-card-bg-hover, rgba(0, 0, 0, 0.05));
	}

	[data-mg-editor] .mg-editor-token,
	[data-mg-editor] .mg-editor-toolbar,
	[data-mg-editor] .mg-editor-foot {
		padding: 0.75rem 1.25rem;
	}
	[data-mg-editor] .mg-editor-token {
		background: var(--btn-card-bg-hover, rgba(0, 0, 0, 0.02));
		border-bottom: 1px solid var(--line-divider, #e5e7eb);
	}
	[data-mg-editor] .mg-editor-label {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 0.4rem;
	}
	[data-mg-editor] .mg-editor-label-tip {
		font-size: 0.7rem;
		font-weight: 400;
		color: var(--content-meta, #6b7280);
	}
