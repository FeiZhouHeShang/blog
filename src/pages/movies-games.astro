		}

		// base64 编码（兼容中文）
		function utf8ToBase64(s) {
			return btoa(unescape(encodeURIComponent(s)));
		}

		// base64 解码
		function base64ToUtf8(b64) {
			return decodeURIComponent(escape(atob(b64.replace(/\n/g, ""))));
		}

		// ===== GitHub API =====
		async function loadRemote() {
			var token = getPat();
			if (!token) {
				setStatus($("mg-editor-status"), "请先填写 GitHub PAT", "error");
				return;
			}
			setStatus($("mg-editor-status"), "正在从 GitHub 加载...", "");
			state.loading = true;
			try {
				var r = await fetch(API_FILE_URL, {
					headers: {
						Accept: "application/vnd.github+json",
						Authorization: "Bearer " + token,
					},
				});
				if (!r.ok) {
					var err = await r.json().catch(function () { return {}; });
					throw new Error(
						"加载失败 " + r.status + "： " + (err.message || r.statusText)
					);
				}
				var file = await r.json();
				state.sha = file.sha;
				state.sourceContent = base64ToUtf8(file.content || "");

				// 用平衡 [] 匹配找数组字面量区间（处理嵌套 tags 数组）
				var range = findArrayRange(state.sourceContent);
				if (!range) throw new Error("源文件格式异常，找不到 moviesGames 数组");
				var arrLiteral = state.sourceContent.substring(range.start, range.end);
				var parsed;
				try {
					parsed = new Function("return (" + arrLiteral + ");")();
				} catch (parseErr) {
					throw new Error("解析 moviesGames 数组失败：" + parseErr.message);
				}
				if (!Array.isArray(parsed)) throw new Error("解析结果不是数组");
				state.items = parsed;
				setStatus(
					$("mg-editor-status"),
					"已加载 " + state.items.length + " 条 · SHA " + state.sha.slice(0, 7),
					"ok"
				);
				renderList();
				restoreDraft();
			} catch (e) {
				setStatus($("mg-editor-status"), "❌ " + e.message, "error");
			} finally {
				state.loading = false;
			}
		}

		// ===== 本地草稿（不再直推 GitHub，统一由「上传中心」一次性提交）=====
		var _mgDraftTimer = null;
		function scheduleDraftSave() {
			if (_mgDraftTimer) clearTimeout(_mgDraftTimer);
			_mgDraftTimer = setTimeout(function () { saveDraftLocal(); }, 800);
		}
		async function saveDraftLocal() {
			var ds = getDs();
			if (!ds || !ds.putDraft) {
				setStatus($("mg-editor-foot-status"), "本地草稿模块未就绪，请刷新页面", "error");
				return;
			}
			if (state.saving) return;
			state.saving = true;
			var saveBtn = $("mg-editor-save");
			if (saveBtn) saveBtn.disabled = true;
			try {
			if (!state.sourceContent && !state.sourceTemplate) {
				setStatus($("mg-editor-foot-status"), "❌ 无可用源文件模板（SSR 未注入），请点「加载远端」后再存", "error");
				return;
			}
			var tpl = state.sourceContent || state.sourceTemplate;
			var newSource = serializeToSource(tpl, state.items);
			var newContent = utf8ToBase64(newSource);
			await ds.putDraft({
				feature: "movies-games",
				id: SRC_PATH,
				label: "影视游戏（" + state.items.length + " 条）",
				files: [{ path: SRC_PATH, content: newContent, sha: null }],
			});
			state.sourceContent = newSource;
			setStatus($("mg-editor-foot-status"), "✅ 已存为本地草稿 · 待右下角「上传中心」统一推送", "ok");
			renderDraftPanel();
			} catch (e) {
				setStatus($("mg-editor-foot-status"), "❌ " + e.message, "error");
			} finally {
				state.saving = false;
				if (saveBtn) saveBtn.disabled = false;
			}
		}
		// 加载远端后，若本地有未上传草稿则覆盖（断点续编）
		async function restoreDraft() {
			var ds = getDs();
			if (!ds || !ds.getDraft) return;
			var d = await ds.getDraft("movies-games", SRC_PATH);
			if (!d || !d.files || !d.files.length || d.files[0].delete) return;
			var src = base64ToUtf8(d.files[0].content || "");
			var range = findArrayRange(src);
			if (!range) return;
			try {
				var arr = new Function("return (" + src.substring(range.start, range.end) + ");")();
				if (!Array.isArray(arr)) return;
				state.items = arr;
				state.sourceContent = src;
				setStatus($("mg-editor-foot-status"), "⚠️ 已载入本地未上传草稿（" + arr.length + " 条）", "ok");
				renderList();
			} catch (_e) {}
		}

		// ===== 待上传：本地草稿面板 =====
		// 展示当前已存为本地草稿的内容，支持「载入」（断点续编）与「删除」（清理多余本地保存）。
		async function renderDraftPanel() {
			var panel = $("mg-draft-panel");
			if (!panel) return;
			var ds = getDs();
			if (!ds || !ds.getDraft) {
				panel.innerHTML = '<p class="mg-draft-empty">本地草稿模块未就绪，请刷新页面</p>';
				return;
			}
			var d = null;
			try { d = await ds.getDraft("movies-games", SRC_PATH); } catch (e) {}
			if (!d || !d.files || !d.files.length || d.files[0].delete) {
				panel.innerHTML = '<p class="mg-draft-empty">暂无本地草稿 · 编辑后点「💾 存本地」会显示在这里</p>';
				return;
			}
			var src = "";
			try { src = base64ToUtf8(d.files[0].content || ""); } catch (e) {}
			var count = 0;
			try {
				var range = findArrayRange(src);
				if (range) {
					var arr = new Function("return (" + src.substring(range.start, range.end) + ");")();
					if (Array.isArray(arr)) count = arr.length;
				}
			} catch (e) {}
			var when = "未知时间";
			try {
				var dt = new Date(d.updatedAt);
				if (!isNaN(dt.getTime())) {
					when = dt.toLocaleString("zh-CN", { hour12: false });
				}
			} catch (e) {}
			panel.innerHTML =
				'<div class="mg-draft-card">' +
					'<div class="mg-draft-info">' +
						'<div class="mg-draft-title">📦 ' + escHtml(d.label || "影视游戏草稿") + '</div>' +
						'<div class="mg-draft-meta">共 ' + count + ' 条 · 更新于 ' + escHtml(when) + '</div>' +
					'</div>' +
					'<div class="mg-draft-actions">' +
						'<button type="button" class="mg-editor-mini" data-draft-act="load">载入</button>' +
						'<button type="button" class="mg-editor-mini mg-editor-mini-danger" data-draft-act="del">删除</button>' +
					'</div>' +
				'</div>';
		}

		// ===== 列表渲染 =====
		function renderList() {
			var list = $("mg-editor-list");
			if (!list) return;
			$("mg-editor-count").textContent = state.items.length;
			if (state.items.length === 0) {
				list.innerHTML =
					'<div class="mg-editor-empty">暂无条目，点击上方「+ 新增条目」开始添加</div>';
				return;
			}
			var html = state.items
				.map(function (it, idx) {
					var isEditing = state.editingId === it.id;
					var coverHtml = it.cover
						? '<img src="' +
							escHtml(it.cover) +
							'" alt="" onerror="this.style.display=\'none\'" />'
						: escHtml((it.title || "?").charAt(0));
					var tagsHtml = (it.tags || [])
						.slice(0, 3)
						.map(function (t) {
							return '<span class="mg-row-badge" style="background:' + statusColor(it.status) + ';">' + escHtml(t) + "</span>";
						})
						.join("");
					var row = "";
					if (isEditing) {
						row =
							'<div class="mg-row is-editing" data-row-id="' + escHtml(it.id) + '">' +
								renderForm(it) +
							"</div>";
					} else {
						row =
							'<div class="mg-row" data-row-id="' + escHtml(it.id) + '">' +
								'<div class="mg-row-thumb">' + coverHtml + "</div>" +
								'<div class="mg-row-info">' +
									'<div class="mg-row-title">' + escHtml(it.title || "(无标题)") + "</div>" +
									'<div class="mg-row-meta">' +
										'<span class="mg-row-badge" style="background:var(--primary,#6366f1);">' + escHtml(sectionLabel(it.section)) + "</span>" +
										'<span class="mg-row-badge" style="background:' + statusColor(it.status) + ';">' + escHtml(statusLabel(it)) + "</span>" +
										tagsHtml +
									"</div>" +
								"</div>" +
								'<div class="mg-row-actions">' +
									'<button type="button" class="mg-row-act" data-act="edit" data-id="' + escHtml(it.id) + '">编辑</button>' +
									'<button type="button" class="mg-row-act mg-row-act-danger" data-act="del" data-id="' + escHtml(it.id) + '">删除</button>' +
								"</div>" +
							"</div>";
					}
					return row;
				})
				.join("");
			list.innerHTML = html;
		}

		function renderForm(item) {
			var sectionOpts = SECTIONS.map(function (s) {
				return '<option value="' + s.key + '"' + (s.key === item.section ? " selected" : "") + ">" + s.label + "</option>";
			}).join("");
			var statusOpts = STATUSES.map(function (s) {
				return '<option value="' + s.key + '"' + (s.key === item.status ? " selected" : "") + ">" + s.label + "</option>";
			}).join("");
			var tagsVal = (item.tags || []).join(", ");
			return (
				'<div class="mg-form-grid">' +
					'<div class="mg-form-field mg-form-full">' +
						'<label>标题 *</label>' +
						'<div class="mg-form-title-row">' +
						'<input type="text" class="mg-editor-input-sm" data-f="title" value="' + escHtml(item.title || "") + '" placeholder="输入名称（失焦/回车自动匹配），或粘贴 TMDB 链接" />' +
						'<button type="button" class="mg-editor-btn mg-form-search-btn" data-act="tmdb-search" title="在 TMDB 搜名称（自动中/英/原名回退）；也可直接粘贴 themoviedb.org 链接精确匹配。候选点选自动填字段">' +
								'<span class="mg-form-search-icon">🔍</span>' +
								'<span>智能匹配</span>' +
							'</button>' +
						'</div>' +
					'</div>' +
					'<div class="mg-form-field mg-form-full mg-tmdb-section" data-tmdb-host style="display:none;">' +
						'<div class="mg-tmdb-head">' +
							'<span class="mg-tmdb-title">TMDB 候选</span>' +
							'<span class="mg-tmdb-status" data-tmdb-status></span>' +
							'<button type="button" class="mg-editor-mini" data-act="tmdb-close" title="关闭候选">×</button>' +
						'</div>' +
						'<div class="mg-tmdb-list" data-tmdb-list></div>' +
					'</div>' +
				'<div class="mg-form-field mg-form-full">' +
					'<label>封面 URL（可选，留空显示首字占位）</label>' +
					'<input type="text" class="mg-editor-input-sm" data-f="cover" value="' + escHtml(item.cover || "") + '" placeholder="TMDB 命中会自动填入海报地址；若国内 image.tmdb.org 被墙导致封面不显示，可改填 ① 豆瓣/Bangumi/图床直链 ② 本地图 /assets/images/movies-games/xxx.jpg" />' +
					'<p class="mg-field-hint">TMDB 自动匹配会先填 image.tmdb.org 链接；若加载不出，直接在此手动换成上面任一方式即可。本地图放仓库 public/assets/images/movies-games/ 下。</p>' +
				"</div>" +
					'<div class="mg-form-field">' +
						'<label>类型</label>' +
						'<select class="mg-editor-select" data-f="section">' + sectionOpts + "</select>" +
					"</div>" +
					'<div class="mg-form-field">' +
						'<label>状态</label>' +
						'<select class="mg-editor-select" data-f="status">' + statusOpts + "</select>" +
					"</div>" +
					'<div class="mg-form-field">' +
						'<label>唯一 ID</label>' +
						'<input type="text" class="mg-editor-input-sm" data-f="id" value="' + escHtml(item.id || "") + '" />' +
					"</div>" +
					'<div class="mg-form-field mg-form-full">' +
