		// 收集表单字段
		function collectForm(rowEl) {
			var item = { id: "", title: "", cover: "", section: "movie", status: "collect" };
			rowEl.querySelectorAll("[data-f]").forEach(function (inp) {
				var k = inp.getAttribute("data-f");
				var v = inp.value;
				if (k === "tags")
					v = v
						.split(",")
						.map(function (x) { return x.trim(); })
						.filter(Boolean);
				if (k === "cover" && v === "") v = "";
				if (v === "" && (k === "comment" || k === "bangumiUrl")) {
					// 保留 undefined
				} else if (k === "tags" && (!v || v.length === 0)) {
					// 保留 undefined
				} else {
					item[k] = v;
				}
			});
			// 清理 undefined 字段
			Object.keys(item).forEach(function (k) {
				if (item[k] === undefined) delete item[k];
			});
			return item;
		}

		// ===== 事件绑定 =====
		function openEditor() {
			var dlg = $("mg-editor");
			if (!dlg) return;
			if (typeof dlg.showModal === "function") dlg.showModal();
			else dlg.setAttribute("open", "");
			// 自动填 token
			var patInput = $("mg-editor-pat");
			if (patInput) {
				patInput.value = getPat();
				setTimeout(function () { patInput.focus(); }, 50);
			}
			// 打开即展示本地草稿（无论是否填 PAT），让用户随时能看到 / 清理待上传内容
			renderDraftPanel();
			// 若已填 PAT 且远端尚未加载，则自动拉一次最新（拿到最新 sha，便于后续「上传中心」一次性推送）
			if (getPat() && !state.sourceContent) {
				loadRemote();
			}
		}
		function closeEditor() {
			var dlg = $("mg-editor");
			if (!dlg) return;
			if (typeof dlg.close === "function") dlg.close();
			else dlg.removeAttribute("open");
			state.editingId = null;
		}

		function bind() {
			var openBtn = $("mg-open-editor");
			if (openBtn) openBtn.addEventListener("click", openEditor);
			$("mg-editor-close")?.addEventListener("click", closeEditor);
			$("mg-editor-cancel")?.addEventListener("click", closeEditor);

			// 点击 backdrop 关闭
			$("mg-editor")?.addEventListener("click", function (e) {
				if (e.target === $("mg-editor")) closeEditor();
			});

			// Esc 关闭
			$("mg-editor")?.addEventListener("cancel", function (e) {
				e.preventDefault();
				closeEditor();
			});

			// Token 输入实时存
			$("mg-editor-pat")?.addEventListener("input", function (e) {
				setPat(e.target.value);
			});
			// 显示/隐藏
			$("mg-editor-pat-toggle")?.addEventListener("click", function () {
				var inp = $("mg-editor-pat");
				if (!inp) return;
				inp.type = inp.type === "password" ? "text" : "password";
			});
			// 清除
			$("mg-editor-pat-clear")?.addEventListener("click", function () {
				if (!confirm("确定清除本地保存的 GitHub PAT？")) return;
				setPat("");
				var inp = $("mg-editor-pat");
				if (inp) inp.value = "";
				setStatus($("mg-editor-status"), "已清除本地 Token", "ok");
			});

			// 加载
			$("mg-editor-load")?.addEventListener("click", function () {
				state.editingId = null;
				loadRemote();
			});
			// 新增
			$("mg-editor-add")?.addEventListener("click", function () {
				var newItem = {
					id: genId("untitled"),
					title: "",
					cover: "",
					section: "movie",
					status: "wish",
				};
				state.items.unshift(newItem);
				state.editingId = newItem.id;
				renderList();
				scheduleDraftSave();
			});
			// 存为本地草稿（统一由「上传中心」推送）
			$("mg-editor-save")?.addEventListener("click", saveDraftLocal);

			// 待上传草稿面板：载入 / 删除（事件委托，元素每次重渲染都有效）
			$("mg-draft-panel")?.addEventListener("click", function (e) {
				var btn = e.target.closest("[data-draft-act]");
				if (!btn) return;
				var act = btn.getAttribute("data-draft-act");
				var ds = getDs();
				if (!ds) return;
				if (act === "del") {
					if (!confirm("确定删除本地草稿？（不影响已推送到仓库的内容）")) return;
					ds.deleteDraft("movies-games", SRC_PATH)
						.then(function () {
							setStatus($("mg-editor-foot-status"), "🗑 已删除本地草稿", "ok");
							renderDraftPanel();
						})
						.catch(function (err) {
							setStatus($("mg-editor-foot-status"), "❌ " + (err && err.message ? err.message : err), "error");
						});
				} else if (act === "load") {
					// 载入草稿到编辑区（断点续编）
					ds.getDraft("movies-games", SRC_PATH)
						.then(function (d) {
							if (!d || !d.files || !d.files.length) return;
							var src = "";
							try { src = base64ToUtf8(d.files[0].content || ""); } catch (e2) { return; }
							var range = findArrayRange(src);
							if (!range) return;
							try {
								var arr = new Function("return (" + src.substring(range.start, range.end) + ");")();
								if (!Array.isArray(arr)) return;
								state.items = arr;
								state.sourceContent = src;
								state.sourceTemplate = src;
								renderList();
								setStatus($("mg-editor-foot-status"), "📥 已载入本地草稿（" + arr.length + " 条）", "ok");
							} catch (e3) {
								setStatus($("mg-editor-foot-status"), "❌ 草稿解析失败：" + e3.message, "error");
							}
						})
						.catch(function (err) {
							setStatus($("mg-editor-foot-status"), "❌ " + (err && err.message ? err.message : err), "error");
						});
				}
			});

			// 列表事件委托
			$("mg-editor-list")?.addEventListener("click", function (e) {
				var btn = e.target.closest("[data-act]");
				if (!btn) return;
				var act = btn.getAttribute("data-act");
				var id = btn.getAttribute("data-id");
				var rowEl = btn.closest(".mg-row");
				if (act === "edit") {
					state.editingId = id;
					renderList();
				} else if (act === "del") {
					if (!confirm("确定删除「" + (state.items.find(function (x) { return x.id === id; })?.title || id) + "」？")) return;
					state.items = state.items.filter(function (x) { return x.id !== id; });
					if (state.editingId === id) state.editingId = null;
					renderList();
					scheduleDraftSave();
				} else if (act === "cancel") {
					// 取消编辑：若 id 是新生成且无标题，从列表删除
					var item = state.items.find(function (x) { return x.id === state.editingId; });
					if (item && !item.title) {
						state.items = state.items.filter(function (x) { return x.id !== state.editingId; });
					}
					state.editingId = null;
					renderList();
					scheduleDraftSave();
				} else if (act === "save-row") {
					if (!rowEl) return;
					var data = collectForm(rowEl);
					if (!data.title || !data.title.trim()) {
						alert("请填写标题");
						return;
					}
					// 用表单中的 id（可能用户改过）
					var idx = state.items.findIndex(function (x) { return x.id === state.editingId; });
					if (idx >= 0) {
						// 检查 id 冲突
						if (data.id !== state.editingId &&
							state.items.some(function (x) { return x.id === data.id; })) {
							alert("ID 已被占用：" + data.id);
							return;
						}
						state.items[idx] = data;
					}
					state.editingId = null;
					renderList();
					scheduleDraftSave();
				} else if (act === "tmdb-search") {
					if (!rowEl) return;
					var titleInp = rowEl.querySelector('[data-f="title"]');
					var q = titleInp ? titleInp.value.trim() : "";
					if (!q) {
						alert("请先填写标题");
						if (titleInp) titleInp.focus();
						return;
					}
					runTmdbSearch(rowEl, q);
				} else if (act === "tmdb-close") {
					var host2 = rowEl && rowEl.querySelector("[data-tmdb-host]");
					if (host2) host2.style.display = "none";
				}
			});

			// 候选点击（在 list 上也监听 candidate 按钮，与 list 共用冒泡）
			$("mg-editor-list")?.addEventListener("click", function (e) {
				var cand = e.target.closest(".mg-tmdb-candidate");
				if (!cand) return;
				var rowEl = cand.closest(".mg-row");
				if (!rowEl) return;
				var idx = parseInt(cand.getAttribute("data-tmdb-idx"), 10);
				var results = tmdbCache[rowEl.getAttribute("data-row-id")] || [];
				applyTmdbResult(rowEl, results, idx);
			});

			// 标题框聚焦时记住当前名称，作为「是否改动」的基准
			$("mg-editor-list")?.addEventListener("focusin", function (e) {
				var inp = e.target.closest && e.target.closest('[data-f="title"]');
				if (!inp) return;
				var rowEl = inp.closest(".mg-row");
				if (rowEl) rowEl._mgLastQuery = inp.value;
			});
			// 标题框自动触发搜索：失焦（focusout 可冒泡）或按回车，免去手动点「智能匹配」
			// 跳过点「智能匹配 / 保存 / 取消」按钮的失焦，避免重复搜索；
			// 标题没改过（比如只是去改封面又回来）则不重搜，避免覆盖手动填的封面。
			$("mg-editor-list")?.addEventListener("focusout", function (e) {
				var inp = e.target.closest && e.target.closest('[data-f="title"]');
				if (!inp) return;
				var rowEl = inp.closest(".mg-row");
				if (!rowEl || !rowEl.isConnected) return;
				var q = (inp.value || "").trim();
				var last = ((rowEl._mgLastQuery || "").trim());
				if (q === last) return; // 名字没变，不重搜
				var rel = e.relatedTarget;
				if (
					rel && rel.closest && rel.matches &&
					rel.closest(".mg-row") === rowEl &&
					rel.matches('[data-act="tmdb-search"],[data-act="save-row"],[data-act="cancel"]')
				) return;
				rowEl._mgLastQuery = q;
				autoSearchFromTitle(rowEl, q);
			});
			$("mg-editor-list")?.addEventListener("keydown", function (e) {
				if (e.key !== "Enter") return;
				var inp = e.target.closest && e.target.closest('[data-f="title"]');
				if (!inp) return;
				e.preventDefault();
				var rowEl = inp.closest(".mg-row");
				if (!rowEl || !rowEl.isConnected) return;
				var q = (inp.value || "").trim();
				if (q === ((rowEl._mgLastQuery || "").trim())) return; // 没改不搜
				rowEl._mgLastQuery = q;
				autoSearchFromTitle(rowEl, q);
			});
		}

		// Astro 软导航兼容
		function init() { bind(); }
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
		if (typeof window !== "undefined" && window.Astro && window.Astro.on) {
			window.Astro.on("page-load", bind);
		}
	})();
</script>
