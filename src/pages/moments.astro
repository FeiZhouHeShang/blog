		background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff;
		border: 1px solid transparent; box-shadow: 0 1px 2px rgba(99, 102, 241, 0.25);
	}
	[data-dg-editor] .dg-form-upload-btn:hover { background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%); box-shadow: 0 2px 6px rgba(99, 102, 241, 0.4); }
	[data-dg-editor] .dg-form-upload-btn:disabled { opacity: 0.6; cursor: wait; }
