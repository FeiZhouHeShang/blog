---
import CalendarGrid from "@components/pages/calendar/CalendarGrid.svelte";
import EventDetailPanel from "@components/pages/calendar/EventDetailPanel.svelte";
import EventOverview from "@components/pages/calendar/EventOverview.svelte";
import PageTitle from "@/components/common/PageTitle.astro";
import { calendarConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/calendar.css";
import type { HolidayEntry } from "@/pages/api/holidays.json";
import type { PostMeta } from "@/utils/calendar-events";

if (!siteConfig.pages.calendar) {
	return Astro.redirect("/404/");
}

const title = calendarConfig.title || i18n(I18nKey.calendar);
const description =
	calendarConfig.description || i18n(I18nKey.calendarDescription);

const { show, overview, birthdays, schedules } = calendarConfig;
const { posts: showPosts, lunarDate: showLunar } = show;
const { futureDays, maxItems } = overview;

// 计算涉及年份：当前年 ± 1（确保概览和网格覆盖）
const now = new Date();
const years = [now.getFullYear() - 1, now.getFullYear(), now.getFullYear() + 1];

// SSR 拉取节日数据 & 文章数据
// [关键词: calendar-ssr-fetch] 失败兜底：
//   dev 下若 wrangler dev (8787) 没跑，Astro 内置 fetch /api/holidays.json 会 ETIMEDOUT，
//   把整页搞红。包一层超时 + try/catch 兜底空数组，生产 build 仍正常。
async function safeJson(url: URL, timeoutMs = 4000): Promise<any[]> {
	try {
		const res = await fetch(url, { signal: AbortSignal.timeout(timeoutMs) });
		return res.ok ? await res.json() : [];
	} catch (e) {
		console.warn(`[calendar] fetch ${url.pathname} failed:`, e);
		return [];
	}
}
const [holidays, posts] = await Promise.all([
	safeJson(new URL("/api/holidays.json", Astro.url)),
	safeJson(new URL("/api/allPostMeta.json", Astro.url)),
]);

const overviewProps = {
	holidays,
	posts,
	birthdays,
	schedules,
	years,
	futureDays,
	maxItems,
	showPosts,
};
const gridProps = {
	holidays,
	posts,
	birthdays,
	schedules,
	years,
	showPosts,
	showLunar,
};
const detailProps = { holidays, posts, birthdays, schedules, years, showPosts };
---

<MainGridLayout title={title} description={description}>
	<div class="calendar-page">
		<div class="calendar-page__shell">
			<header class="calendar-page__header">
				<PageTitle title={title} variant="stacked" />
			</header>

			<aside class="calendar-page__rail calendar-page__rail--left" aria-label={i18n(I18nKey.calendarUpcoming)}>
				<EventOverview client:load {...overviewProps} />
			</aside>

			<main class="calendar-page__main" aria-label={title}>
				<CalendarGrid client:load {...gridProps} />
			</main>

			<aside class="calendar-page__rail calendar-page__rail--right" aria-label={i18n(I18nKey.calendarTodayEvents)}>
				<EventDetailPanel client:load {...detailProps} />
			</aside>
		</div>
	</div>
</MainGridLayout>
