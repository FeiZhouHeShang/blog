---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LeftSidebar from "@/components/layout/LeftSidebar.astro";
import RightSidebar from "@/components/layout/RightSidebar.astro";
import { editorSecrets } from "@/config/editorSecrets";

// 文章前端编辑器（写 / 改）
// 三连常驻布局：编辑 | 预览 | 属性 —— 去掉预览按钮，预览常驻显示
// 左右两侧为全局仪表盘（MainGridLayout slot），编辑时「往外同步移动」= 中间 .pe-editor 满宽
// 后台：PAT(导入密钥) + draftStore(本地草稿) + uploadCenter(统一推送) + ImgBed(图片上传)
// 实时预览：dev 调 /api/render-preview/（完整 markdown-render.mjs 管线 = 发布页），
//           prod 走客户端 src/scripts/mini-markdown.mjs 兜底（基础 markdown + callout/mermaid/plantuml/katex 占位）
const title = "写文章";
const description = "支持 Markdown 语法，编辑后通过 GitHub API 提交到仓库。";

const REPO = "FeiZhouHeShang/blog";
const API_TREE_URL = `https://api.github.com/repos/${REPO}/git/trees/main?recursive=1`;
const API_CONTENT = (p: string) =>
	`https://api.github.com/repos/${REPO}/contents/${p}?ref=main`;
const PAT_HELP_URL =
	"https://github.com/settings/personal-access-tokens/new?description=post-editor&contents=write";
const COMMIT_URL_BASE = `https://github.com/${REPO}/commits/main/src/content/posts`;
const IMGBED_POST_DIR_PREFIX = "文章";
---

<MainGridLayout title={title} description={description}>
	<LeftSidebar slot="sidebar-left" />
	<RightSidebar slot="sidebar-right" />

	<div class="pe-page-wrapper" id="pe-root">
		<!-- ========== 文章列表视图（fqzlr catalog 风：按分类分组挑选编辑） ========== -->
		<div id="pe-list-view" class="pe-page pe-list-page" hidden>
			<div class="pe-page-head">
				<div class="pe-page-head-left">
					<span class="pe-page-eyebrow">WRITE</span>
					<h1 class="pe-page-title">文章列表</h1>
					<p class="pe-page-sub">选择下方文章编辑，或新建一篇</p>
				</div>
				<button type="button" id="pe-new-post" class="pe-toolbar-btn pe-btn-publish">＋ 写新文章</button>
			</div>
			<div data-pe-catalog class="pe-catalog"></div>
			<p data-pe-catalog-empty class="pe-empty" hidden>暂无文章，点右上角「写新文章」开始。</p>
		</div>

		<!-- ========== 编辑器视图（编辑 | 预览 | 属性 三连常驻） ========== -->
		<div
			id="pe-editor"
			class="pe-page pe-editor"
			data-pe-editor=""
			data-pe-mode={import.meta.env.DEV ? "dev" : "prod"}
			data-imgbed-url={editorSecrets.imageBedUrl}
			data-imgbed-auth={import.meta.env.PUBLIC_IMGBED_UPLOAD_CODE ?? ""}
			data-imgbed-token={import.meta.env.PUBLIC_IMG_UPLOAD_TOKEN ?? ""}
			hidden
		>
			<!-- 页头（WRITE ＋ 大标题 ＋ 副标题） -->
			<div class="pe-page-head pe-page-head-editor">
				<div class="pe-page-head-left">
					<span class="pe-page-eyebrow">WRITE</span>
					<h1 class="pe-page-title" id="pe-editor-title">写文章</h1>
					<p class="pe-page-sub">支持 Markdown 语法，编辑后通过 GitHub API 提交到仓库。左侧编辑、右侧预览，最右侧填写标题/标签/封面等属性。</p>
				</div>
			</div>

			<!-- 工具栏（5 按钮：← 返回列表 / 导入MD / 保存草稿 / 导入密钥 / 发表呀；预览已常驻不再需要按钮） -->
			<div class="pe-toolbar" role="toolbar" aria-label="编辑器工具栏">
				<button type="button" id="pe-toolbar-back" class="pe-toolbar-btn" title="返回文章列表">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
					<span>返回列表</span>
				</button>
				<span class="pe-toolbar-divider"></span>
				<button type="button" id="pe-toolbar-import-md" class="pe-toolbar-btn" title="导入本地 .md 文件">📥 导入MD</button>
				<button type="button" id="pe-toolbar-save" class="pe-toolbar-btn pe-btn-save" title="保存到本地草稿（无需令牌）">💾 保存草稿</button>
				<button type="button" id="pe-toolbar-key" class="pe-toolbar-btn pe-btn-key" title="点击选择密钥文件（.txt / .pem）一键导入">🔑 导入密钥</button>
				<button type="button" id="pe-toolbar-publish" class="pe-toolbar-btn pe-btn-publish" title="保存到本地草稿 + 打开上传中心统一推送">🚀 发表呀</button>
				<button type="button" id="pe-toolbar-fullscreen" class="pe-toolbar-btn pe-btn-fs" title="切换全屏编辑模式（隐藏左右侧栏）">⤢ 全屏</button>
				<button type="button" id="pe-toolbar-side" class="pe-toolbar-btn pe-btn-side is-active" title="显示/隐藏右侧属性栏（收起后编辑 + 预览区域翻倍）">⚙ 属性</button>
				<button type="button" id="pe-toolbar-img" class="pe-toolbar-btn pe-btn-img" title="插入图片：上传文件或粘贴图片 URL">🖼 插入图片</button>
				<button type="button" id="pe-toolbar-sync" class="pe-toolbar-btn pe-btn-sync" title="滚动同步：未锁定（左右独立滚动；先把两边滚到对齐位置，再点此锁定联动）">🔗 锁同步</button>
				<span class="pe-toolbar-spacer"></span>
				<span id="pe-preview-mode-chip" class="pe-preview-mode-chip" title="客户端 mini-markdown.mjs 兜底渲染">预览：客户端兜底</span>
			</div>

			<!-- 插入图片弹层（顶部「🖼 插入图片」触发）：文件上传 / 粘贴 URL 两种方式 -->
			<div id="pe-img-popover" class="pe-img-popover" hidden>
				<div class="pe-img-pop-head">插入图片</div>
				<button type="button" id="pe-img-upload-btn" class="pe-img-pop-btn">📁 上传图片文件</button>
				<div class="pe-img-pop-or">— 或 粘贴图片 URL —</div>
				<label class="pe-img-pop-field">
					<span>图片 URL</span>
					<input type="url" id="pe-img-url-input" class="pe-input" placeholder="https://example.com/pic.jpg" />
				</label>
				<div class="pe-img-pop-actions">
					<button type="button" id="pe-img-url-insert" class="pe-toolbar-btn pe-btn-save">插入</button>
					<button type="button" id="pe-img-pop-close" class="pe-toolbar-btn">取消</button>
				</div>
			</div>

			<!-- 三连：编辑 | 预览 | 属性（属性栏默认收起，让编辑 + 预览区域翻倍；点工具栏「⚙ 属性」展开） -->
			<div class="pe-editor-main" id="pe-editor-main" data-side="collapsed">
				<!-- 左：编辑列 -->
				<section class="pe-editor-col pe-editor-col-edit" aria-label="编辑区">
					<textarea id="pe-f-title" class="pe-title-input" rows="1" placeholder="输入文章标题..." aria-label="文章标题"></textarea>

					<!-- Markdown 工具栏 -->
					<div class="pe-md-toolbar" role="toolbar" aria-label="Markdown 格式工具栏">
						<button type="button" class="pe-md-tb" data-md="bold" title="加粗 Ctrl+B"><b>B</b></button>
						<button type="button" class="pe-md-tb" data-md="italic" title="斜体 Ctrl+I"><i>I</i></button>
						<span class="pe-md-tb-divider"></span>
						<button type="button" class="pe-md-tb" data-md="h1" title="一级标题">H1</button>
						<button type="button" class="pe-md-tb" data-md="h2" title="二级标题">H2</button>
						<button type="button" class="pe-md-tb" data-md="h3" title="三级标题">H3</button>
						<span class="pe-md-tb-divider"></span>
						<button type="button" class="pe-md-tb" data-md="quote" title="引用">❝</button>
						<button type="button" class="pe-md-tb" data-md="code" title="行内代码">‹›</button>
						<button type="button" class="pe-md-tb" data-md="codeblock" title="代码块">⌘</button>
						<button type="button" class="pe-md-tb" data-md="ul" title="无序列表">☰</button>
						<button type="button" class="pe-md-tb" data-md="ol" title="有序列表">1.</button>
						<button type="button" class="pe-md-tb" data-md="link" title="链接 Ctrl+K">🔗</button>
						<button type="button" class="pe-md-tb" data-md="image" title="插入图片">🖼</button>
						<button type="button" class="pe-md-tb" data-md="hr" title="分割线">—</button>
					</div>

					<textarea id="pe-f-body" class="pe-body-input" placeholder="开始写作...  支持 Markdown 语法 快捷键: Ctrl+B 加粗 / Ctrl+I 斜体 / Ctrl+K 链接 / Ctrl+S 保存草稿" aria-label="文章正文 Markdown"></textarea>
				</section>

				<!-- 中：预览列（常驻） -->
				<section class="pe-editor-col pe-editor-col-preview" aria-label="实时预览">
					<div class="pe-preview-head">
						<span class="pe-preview-head-title">👁 实时预览</span>
						<span id="pe-preview-status" class="pe-preview-status"></span>
					</div>
					<div id="pe-preview" class="prose dark:prose-invert prose-base max-w-none! custom-md pe-preview" data-empty="true">
						<div class="pe-preview-empty">
							<div class="pe-preview-empty-icon">✨</div>
							<div class="pe-preview-empty-text">在左侧开始写作<br />预览将在这里实时出现</div>
						</div>
					</div>
				</section>

				<!-- 右：属性列 -->
				<aside class="pe-editor-col pe-editor-col-side" aria-label="文章属性">
					<!-- 密钥提示（无密钥时显示橙色框） -->
					<div id="pe-key-notice" class="pe-key-notice">🔑 请点击工具栏「导入密钥」按钮，选择存有密钥的 <code>.txt</code> / <code>.pem</code> 文件一键导入（无需手动粘贴）。<a href="#" id="pe-pat-manual-link" class="pe-link">或手动粘贴</a></div>

					<label class="pe-field">
						<span>📝 文章 Slug</span>
						<input type="text" id="pe-f-slug" class="pe-input" placeholder="article-slug" />
						<small class="pe-field-hint">留空自动从标题生成</small>
					</label>
					<label class="pe-field">
						<span>🖼️ 封面图片 URL</span>
						<input type="url" id="pe-f-cover" class="pe-input" placeholder="https://example.com/cover.jpg" />
					</label>
					<label class="pe-field">
						<span>📝 封面预览</span>
						<textarea id="pe-f-cover-preview" class="pe-input pe-textarea-sm" rows="2" placeholder="封面预览描述（可选）"></textarea>
					</label>
					<label class="pe-field">
						<span>📝 文章描述</span>
						<textarea id="pe-f-desc" class="pe-input pe-textarea-sm" rows="2" placeholder="简短描述文章内容，用于SEO和列表展示"></textarea>
					</label>

					<!-- 标签：保留我们的三连框（fqzlr 是逗号分隔输入 + 下方绿色 chip） -->
					<label class="pe-field">
						<span># 标签</span>
						<div class="pe-tags3" data-tags-for="pe-f-tags">
							<div class="pe-tags3-row">
								<div class="pe-tags3-label">① 已有标签（点击选择）</div>
								<div class="pe-tags3-pool" id="pe-tags-pool" role="listbox" aria-label="已有标签"></div>
							</div>
							<div class="pe-tags3-row">
								<div class="pe-tags3-label">② 新建标签（回车或点 + 添加）</div>
								<div class="pe-tags3-input-wrap">
									<input type="text" id="pe-tag-input" class="pe-input" placeholder="输入新标签名后回车或点 +" autocomplete="off" spellcheck="false" />
									<button type="button" id="pe-tag-add-btn" class="pe-tags3-add-btn">+ 添加</button>
								</div>
							</div>
							<div class="pe-tags3-row">
								<div class="pe-tags3-label">③ 已选择标签（点 × 取消）</div>
								<div class="pe-tags3-selected" id="pe-tags-selected"></div>
							</div>
						</div>
						<input type="hidden" id="pe-f-tags" value="" />
					</label>

					<!-- 分类：照 fqzlr，纯文本输入（datalist 提供候选项） -->
					<label class="pe-field">
						<span>📁 分类</span>
						<input type="text" id="pe-f-cat" class="pe-input" placeholder="教程" list="pe-f-cat-list" autocomplete="off" spellcheck="false" />
						<datalist id="pe-f-cat-list"></datalist>
					</label>

					<label class="pe-field">
						<span>🗓 发布日期</span>
						<input type="date" id="pe-f-pub" class="pe-input" />
					</label>

					<div class="pe-field pe-field-flags">
						<label class="pe-check"><input type="checkbox" id="pe-f-draft" /> 📝 草稿（不发布）</label>
						<label class="pe-check"><input type="checkbox" id="pe-f-pinned" /> 📌 置顶文章</label>
					</div>

					<div class="pe-side-divider"></div>

					<!-- 图片上传（简化：去掉 channel 切换，默认图床） -->
					<div class="pe-side-block">
						<button type="button" id="pe-img-pick" class="pe-toolbar-btn pe-side-btn">🖼 上传图片</button>
						<input type="file" id="pe-img-file" accept="image/*" multiple style="display:none;" />
						<p id="pe-img-tip" class="pe-status"></p>
					</div>
				</aside>
			</div>

			<!-- 底部状态栏 + 字符计数 + 快捷键 + 令牌状态 -->
			<footer class="pe-editor-foot">
				<div class="pe-editor-foot-left">
					<span id="pe-char-count" class="pe-char-count">0 字</span>
					<span class="pe-toolbar-divider"></span>
					<span class="pe-kbd-hint">Ctrl+B 加粗 · Ctrl+I 斜体 · Ctrl+K 链接 · Ctrl+S 保存草稿</span>
				</div>
				<div class="pe-editor-foot-right">
					<span id="pe-session-chip" class="pe-session-chip is-lock">🔒 未验证</span>
					<span id="pe-editor-status" class="pe-status">未验证令牌</span>
				</div>
			</footer>

			<!-- PAT 面板（默认折叠，点工具栏「🔑 导入密钥」展开） -->
			<section class="pe-pat-panel" id="pe-pat-panel" hidden>
				<div class="pe-pat-row">
					<input type="password" id="pe-editor-pat" placeholder="github_pat_xxxxxxxxxxxxxx" autocomplete="off" spellcheck="false" class="pe-input" />
					<button type="button" id="pe-editor-pat-toggle" class="pe-toolbar-btn" title="显示/隐藏">👁</button>
					<button type="button" id="pe-editor-pat-validate" class="pe-toolbar-btn pe-btn-save">✅ 验证令牌</button>
					<button type="button" id="pe-editor-pat-clear" class="pe-toolbar-btn pe-btn-danger" title="退出本次会话">🗑</button>
				</div>
				<p class="pe-pat-tip">本次浏览会话有效（关闭浏览器需重输）· <a href={PAT_HELP_URL} target="_blank" rel="noopener noreferrer" class="pe-link">生成 fine-grained PAT</a></p>
			</section>

			<input type="file" id="pe-md-import" accept=".md,.markdown,text/markdown" hidden />
			<!-- 密钥文件选择器（点击「导入密钥」触发，对应 fqzlr 的文件导入方式，免手动粘贴） -->
			<input type="file" id="pe-pat-file" accept=".txt,.pem,.key,application/x-pem-file,text/plain" hidden />
		</div>
	</div>
</MainGridLayout>

<style>
	/* 页面容器 —— 满宽，不限 max-width；编辑器专用把左右侧栏收到 200px，让中间三列尽可能宽 */
	.pe-page-wrapper { padding: 0; max-width: none; width: 100%; --sidebar-width: 200px; }
	/* 全屏编辑模式：完全收起外侧栏（点工具栏「⤢ 全屏」切换）*/
	:global(body.pe-fullscreen) { --sidebar-width: 0px; }
	:global(body.pe-fullscreen) [data-sidebar-position="both"] > :first-child,
	:global(body.pe-fullscreen) [data-sidebar-position="both"] > :last-child,
	:global(body.pe-fullscreen) [data-sidebar-position="left"] > :first-child,
	:global(body.pe-fullscreen) [data-sidebar-position="right"] > :last-child { display: none !important; }
	.pe-page { padding: 1.4rem 1.6rem; }

	/* 页头（WRITE + 大标题 + 副标） */
	.pe-page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
	.pe-page-head-left { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
	.pe-page-eyebrow { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.7rem; letter-spacing: 0.25em; color: var(--content-meta, #6b7280); }
	.pe-page-title { font-size: 2.2rem; font-weight: 700; color: var(--deep-text, #111); margin: 0; line-height: 1.1; }
	.pe-page-sub { font-size: 0.85rem; color: var(--content-meta, #6b7280); margin: 0.2rem 0 0; }

	/* 工具栏按钮（fqzlr 风格：圆形胶囊） */
	.pe-toolbar { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; padding: 0.6rem 0; border-bottom: 1px solid var(--line-divider, #e5e7eb); margin-bottom: 1rem; }
	.pe-toolbar-divider { width: 1px; height: 18px; background: var(--line-divider, #e5e7eb); margin: 0 0.25rem; }
	.pe-toolbar-spacer { flex: 1; }
	.pe-toolbar-btn { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.5rem 1rem; min-height: 38px; border-radius: 999px; cursor: pointer; font-size: 0.85rem; font-weight: 500; border: 1px solid transparent; background: var(--btn-card-bg-hover, #f5f5f7); color: var(--deep-text, #111); transition: all 0.15s ease; }
	.pe-toolbar-btn:hover { background: var(--btn-card-bg-active, #ececf1); }
	.pe-btn-save { background: rgba(59,130,246,0.1); color: #2563eb; border-color: rgba(59,130,246,0.3); }
	.pe-btn-save:hover { background: rgba(59,130,246,0.18); }
	:root.dark .pe-btn-save { background: rgba(59,130,246,0.18); color: #93c5fd; }
	.pe-btn-key { background: rgba(245,158,11,0.1); color: #b45309; border-color: rgba(245,158,11,0.3); }
	.pe-btn-key:hover { background: rgba(245,158,11,0.18); }
	.pe-btn-key.has-key { background: rgba(16,185,129,0.1); color: #047857; border-color: rgba(16,185,129,0.3); }
	.pe-btn-key.has-key:hover { background: rgba(16,185,129,0.18); }
	.pe-btn-publish { background: var(--primary); color: var(--page-bg); border-color: var(--primary); font-weight: 600; }
	.pe-btn-publish:hover { filter: brightness(1.15); }
	:root.dark .pe-btn-publish:hover { filter: brightness(0.9); }
	.pe-btn-publish.is-disabled, .pe-btn-publish:disabled { opacity: 0.5; cursor: not-allowed; filter: grayscale(0.35); }
	.pe-btn-publish.is-disabled:hover, .pe-btn-publish:disabled:hover { filter: grayscale(0.35); }
	.pe-btn-danger { color: #e11d48; border-color: rgba(225,29,72,0.25); background: transparent; }
	.pe-btn-danger:hover { background: rgba(225,29,72,0.08); }
	.pe-btn-fs { background: rgba(139,92,246,0.1); color: #6d28d9; border-color: rgba(139,92,246,0.3); }
	.pe-btn-fs:hover { background: rgba(139,92,246,0.18); }
	.pe-btn-fs.is-active { background: var(--primary); color: var(--page-bg, #fff); border-color: var(--primary); }
	:root.dark .pe-btn-fs { background: rgba(139,92,246,0.18); color: #c4b5fd; }
	.pe-btn-side { background: rgba(16,185,129,0.1); color: #047857; border-color: rgba(16,185,129,0.3); }
	.pe-btn-side:hover { background: rgba(16,185,129,0.18); }
	.pe-btn-side.is-active { background: var(--primary); color: var(--page-bg, #fff); border-color: var(--primary); }
	:root.dark .pe-btn-side { background: rgba(16,185,129,0.18); color: #6ee7b7; }
	.pe-btn-img { background: rgba(245,158,11,0.12); color: #b45309; border-color: rgba(245,158,11,0.35); }
	.pe-btn-img:hover { background: rgba(245,158,11,0.2); }
	:root.dark .pe-btn-img { background: rgba(245,158,11,0.18); color: #fcd34d; }
	.pe-btn-sync { background: rgba(16,185,129,0.1); color: #047857; border-color: rgba(16,185,129,0.3); }
	.pe-btn-sync:hover { background: rgba(16,185,129,0.18); }
	.pe-btn-sync:not(.is-active) { background: var(--btn-card-bg-hover, #f3f4f6); color: var(--content-meta, #9ca3af); border-color: var(--line-divider, #e5e7eb); }
	:root.dark .pe-btn-sync { background: rgba(16,185,129,0.18); color: #6ee7b7; }
	:root.dark .pe-btn-sync:not(.is-active) { background: rgba(255,255,255,0.05); color: #6b7280; }

	/* 插入图片弹层 */
	.pe-img-popover { position: absolute; z-index: 40; top: 4.6rem; left: 1.2rem; width: min(340px, calc(100% - 3rem)); background: var(--card-bg, #fff); border: 1px solid var(--line-divider, #e5e7eb); border-radius: 12px; box-shadow: 0 12px 40px rgba(15,23,42,0.18); padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
	:root.dark .pe-img-popover { background: #1e293b; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
	.pe-img-pop-head { font-size: 0.9rem; font-weight: 700; color: var(--deep-text, #111); }
	.pe-img-pop-btn { width: 100%; padding: 0.6rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 500; border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg-hover, #f5f5f7); color: var(--deep-text, #111); }
	.pe-img-pop-btn:hover { background: var(--btn-card-bg-active, #ececf1); }
	.pe-img-pop-or { text-align: center; font-size: 0.7rem; color: var(--content-meta, #9ca3af); }
	.pe-img-pop-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.75rem; color: var(--content-meta, #6b7280); }
	.pe-img-pop-field .pe-input { width: 100%; }
	.pe-img-pop-actions { display: flex; gap: 0.5rem; justify-content: flex-end; }

	/* 预览模式指示器（统一客户端兜底渲染） */
	.pe-preview-mode-chip { font-size: 0.7rem; padding: 0.25rem 0.7rem; border-radius: 999px; background: var(--btn-card-bg-hover, #f5f5f7); color: var(--content-meta, #6b7280); border: 1px solid var(--line-divider, #e5e7eb); font-weight: 500; }
	.pe-preview-mode-chip[data-mode="client"] { background: rgba(99,102,241,0.1); color: #4f46e5; border-color: rgba(99,102,241,0.3); }
	.pe-preview-mode-chip[data-mode="dev"] { background: rgba(16,185,129,0.1); color: #047857; border-color: rgba(16,185,129,0.3); }
	.pe-preview-mode-chip[data-mode="prod"] { background: rgba(245,158,11,0.1); color: #b45309; border-color: rgba(245,158,11,0.3); }

	/* 列表页 */
	.pe-list-page { max-width: 900px; margin: 0 auto; }
	.pe-catalog { display: flex; flex-direction: column; gap: 1.5rem; }
	.pe-empty { text-align: center; color: var(--content-meta, #6b7280); padding: 2rem 0; }

	/* ============ 编辑器主体：3 列 grid（编辑 | 预览 | 属性） ============ */
	.pe-editor { padding: 1rem 1.2rem; position: relative; }
	.pe-editor-main {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.3fr) 320px;
		gap: 0;
		border: 1px solid var(--line-divider, #e5e7eb);
		border-radius: 12px;
		overflow: hidden;
		background: var(--card-bg, #fff);
		/* 固定高度而非 min-height：textarea 和 preview 必须限制在可视区域才能内部滚动；
		   min-height 会让 grid 被超长内容撑高，textarea 不需要滚 → 同步逻辑空转 */
		height: 75vh;
		min-height: 560px;
	}
	/* 属性栏收起：编辑 + 预览平分满宽（约翻倍） */
	.pe-editor-main[data-side="collapsed"] { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
	.pe-editor-main[data-side="collapsed"] .pe-editor-col-side { display: none; }
	/* 列高 100% 填满 grid 行高（不再单独 min-height，避免和父级 height 冲突导致又可撑高） */
	.pe-editor-col { display: flex; flex-direction: column; min-width: 0; min-height: 0; height: 100%; }
	.pe-editor-col-edit { border-right: 1px solid var(--line-divider, #e5e7eb); }
	.pe-editor-col-preview { border-right: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg-hover, #fafafa); }
	.pe-editor-col-side { padding: 1rem 1.2rem; overflow-y: auto; gap: 0.7rem; background: var(--card-bg, #fff); }

	/* 标题 input */
	.pe-title-input { width: 100%; box-sizing: border-box; padding: 1.2rem 1.4rem 0.6rem; border: none; outline: none; resize: none; background: transparent; font-size: 1.6rem; font-weight: 700; color: var(--deep-text, #111); font-family: inherit; line-height: 1.4; min-height: 60px; overflow: hidden; }
	.pe-title-input::placeholder { color: var(--content-meta, #9ca3af); font-weight: 500; }

	/* MD 工具栏 */
	.pe-md-toolbar { display: flex; align-items: center; gap: 0.15rem; padding: 0.4rem 1.4rem; border-top: 1px solid var(--line-divider, #e5e7eb); border-bottom: 1px solid var(--line-divider, #e5e7eb); background: var(--card-bg, #fff); flex-shrink: 0; }
	.pe-md-tb { min-width: 32px; min-height: 32px; padding: 0 0.5rem; border: none; background: transparent; border-radius: 6px; cursor: pointer; color: var(--content-meta, #6b7280); font-size: 0.85rem; }
	.pe-md-tb:hover { background: var(--btn-card-bg-active, #ececf1); color: var(--primary, #4f46e5); }
	.pe-md-tb-divider { width: 1px; height: 16px; background: var(--line-divider, #e5e7eb); margin: 0 0.25rem; }

	/* body textarea */
	.pe-body-input { flex: 1 1 auto; min-height: 0; padding: 1rem 1.4rem; border: none; outline: none; resize: none; background: transparent; font-size: 0.95rem; line-height: 1.7; color: var(--deep-text, #111); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

	/* 预览列 */
	.pe-preview-head { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 1.4rem; border-bottom: 1px solid var(--line-divider, #e5e7eb); background: var(--card-bg, #fff); flex-shrink: 0; }
	.pe-preview-head-title { font-size: 0.78rem; font-weight: 600; color: var(--deep-text, #111); letter-spacing: 0.05em; }
	.pe-preview-status { font-size: 0.7rem; color: var(--content-meta, #6b7280); font-variant-numeric: tabular-nums; }
	.pe-preview-status.is-loading { color: #2563eb; }
	.pe-preview-status.is-error { color: #e11d48; }
	.pe-preview { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 1rem 1.4rem; }

	/* 右侧属性栏（沿用 .pe-field 等） */
	.pe-key-notice { padding: 0.7rem 0.9rem; border-radius: 8px; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.3); color: #b45309; font-size: 0.78rem; line-height: 1.55; }
	.pe-key-notice.is-hidden { display: none; }

	.pe-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.78rem; color: var(--content-meta, #6b7280); }
	.pe-field > span { font-weight: 500; color: var(--deep-text, #111); }
	.pe-input { padding: 0.5rem 0.7rem; border-radius: 8px; border: 1px solid var(--line-divider, #e5e7eb); background: var(--page-bg, #fff); color: var(--deep-text, #111); font-size: 0.85rem; min-height: 38px; }
	.pe-textarea-sm { min-height: 56px; font-family: inherit; resize: vertical; line-height: 1.5; }
	.pe-field-hint { font-size: 0.68rem; color: var(--content-meta, #9ca3af); line-height: 1.5; }
	.pe-field-flags { flex-direction: column; gap: 0.4rem; align-items: stretch; }
	.pe-check { display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--deep-text, #111); cursor: pointer; }
	.pe-side-divider { height: 1px; background: var(--line-divider, #e5e7eb); margin: 0.3rem 0; }
	.pe-side-block { display: flex; flex-direction: column; gap: 0.5rem; }
	.pe-side-btn { width: 100%; justify-content: center; }
	.pe-status { font-size: 0.72rem; margin: 0; color: var(--content-meta, #6b7280); }
	.pe-status.is-error { color: #f43f5e; }
	.pe-status.is-ok { color: #10b981; }

	/* 底部 */
	.pe-editor-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 0.2rem; margin-top: 0.6rem; flex-wrap: wrap; }
	.pe-editor-foot-left { display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 0; }
	.pe-editor-foot-right { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
	.pe-char-count { font-size: 0.78rem; color: var(--content-meta, #6b7280); font-variant-numeric: tabular-nums; }
	.pe-kbd-hint { font-size: 0.7rem; color: var(--content-meta, #6b7280); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.pe-session-chip { font-size: 0.72rem; padding: 0.2rem 0.65rem; border-radius: 999px; font-weight: 500; }
	.pe-session-chip.is-ok { color: #047857; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.35); }
	.pe-session-chip.is-lock { color: #b45309; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.35); }
	.pe-link { color: var(--primary); text-decoration: none; }

	/* PAT 面板 */
	.pe-pat-panel { padding: 0.8rem 1.4rem; border: 1px solid var(--line-divider, #e5e7eb); border-radius: 8px; margin-top: 0.8rem; background: var(--card-bg, #fff); }
	.pe-pat-row { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; }
	.pe-pat-row .pe-input { flex: 1; min-width: 200px; }
	.pe-pat-tip { font-size: 0.72rem; color: var(--content-meta, #6b7280); margin: 0.5rem 0 0; }

	/* ============ 响应式 ============ */
	/* 默认（>1400px）：3 列 1.6:1.3:340，编辑/预览尽量宽 */
	/* < 1400px：属性列收窄到 300px */
	@media (max-width: 1400px) {
		.pe-editor-main { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.3fr) 300px; }
	}
	/* < 1200px：去掉属性列，让编辑+预览占满 */
	@media (max-width: 1200px) {
		.pe-editor-main { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
		.pe-editor-col-side { display: none; }
	}
	/* < 900px：去掉预览列，只剩编辑（属性栏仍可点折叠按钮呼出） */
	@media (max-width: 900px) {
		.pe-editor-main { grid-template-columns: 1fr; }
		.pe-editor-col-preview { display: none; }
		.pe-editor-col-edit { border-right: none; }
		.pe-kbd-hint { display: none; }
		.pe-page-title { font-size: 1.7rem; }
	}
	/* 移动端：工具栏隐藏文字 */
	@media (max-width: 640px) {
		.pe-toolbar { gap: 0.3rem; }
		.pe-toolbar-btn span { display: none; }
		.pe-toolbar-btn { padding: 0.5rem 0.7rem; }
		.pe-preview-mode-chip { display: none; }
	}
</style>

