	.pe-side-block { display: flex; flex-direction: column; gap: 0.5rem; }
	.pe-side-btn { width: 100%; }
	.pe-side-tip { margin: 0; }
	.pe-side-desc { margin: 0; }
	.pe-textarea-sm { min-height: 56px; font-family: inherit; }
	.pe-field-hint { font-size: 0.68rem; color: var(--content-meta, #9ca3af); line-height: 1.5; }
	.pe-field-hint code { background: rgba(99,102,241,0.08); padding: 0 0.25rem; border-radius: 3px; color: var(--primary); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85em; }

	/* ===== 分类 combo-box ===== */
	.pe-combo { position: relative; }
	.pe-combo-input { padding-right: 2.2rem; }
	.pe-combo-toggle {
		position: absolute; right: 0.4rem; top: 50%; transform: translateY(-50%);
		width: 28px; height: 28px; padding: 0; border: none; background: transparent;
		cursor: pointer; color: var(--content-meta, #6b7280); font-size: 0.9rem; line-height: 1; border-radius: 6px;
	}
	.pe-combo-toggle:hover { background: var(--btn-card-bg-active, #ececf1); color: var(--primary); }
	.pe-combo-menu {
		position: absolute; top: calc(100% + 4px); left: 0; right: 0;
		max-height: 14rem; overflow-y: auto; z-index: 30;
		background: var(--card-bg, #fff); border: 1px solid var(--line-divider, #e5e7eb);
		border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.08);
		padding: 0.25rem 0; margin: 0; list-style: none;
	}
	/* 分类 combo 菜单项、标签 chip / 三连框 均为 innerHTML 动态创建，
	   scoped <style> 不生效，统一下移至末尾的 <style is:global> 块。 */

	/* PAT 面板（折叠） */
	.pe-pat-panel {
		padding: 0.8rem 1.4rem; border-top: 1px solid var(--line-divider, #e5e7eb);
		background: var(--card-bg, #fff); flex-shrink: 0;
	}
	.pe-pat-row { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; }

	/* 字符计数 */
	.pe-editor-foot-left { display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 0; }
	.pe-char-count { font-size: 0.78rem; color: var(--content-meta, #6b7280); font-variant-numeric: tabular-nums; }
	.pe-kbd-hint { font-size: 0.7rem; color: var(--content-meta, #6b7280); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

	/* 响应式：窄屏下右栏下沉到编辑器下方 */
	@media (max-width: 900px) {
		.pe-editor-main { grid-template-columns: 1fr; }
		.pe-editor-side { border-left: none; border-top: 1px solid var(--line-divider, #e5e7eb); }
		.pe-kbd-hint { display: none; }
		.pe-title-input { font-size: 1.3rem; padding: 1rem 1.2rem 0.5rem; }
		.pe-body-input { padding: 0.8rem 1.2rem; }
		.pe-editor-topbar { padding: 0.5rem 0.8rem; }
		.pe-editor-subbar { padding: 0.5rem 0.8rem; }
		.pe-topbar-title { display: none; }
	}
	@media (max-width: 640px) {
		.pe-topbar-left .pe-topbar-divider, .pe-topbar-left .pe-topbar-mode { display: none; }
		.pe-topbar-btn span { display: none; }
		.pe-topbar-btn { padding: 0.4rem 0.55rem; }
	}

	@media (max-width: 640px) {
		.pe-form-grid { grid-template-columns: 1fr; }
		.pe-item { flex-direction: column; align-items: stretch; }
		.pe-item-actions { justify-content: flex-end; }
	}

	/* Markdown 预览容器（套 Markdown.astro 同款 prose+custom-md class，CSS 两侧自动同步） */
	.pe-preview { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 1rem 1.6rem; background: var(--card-bg, #fff); }
		.pe-topbar-btn.is-active { background: var(--btn-card-bg-active, #ececf1); }
		.pe-md-pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; }
