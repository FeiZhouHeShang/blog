---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LeftSidebar from "@/components/layout/LeftSidebar.astro";
import RightSidebar from "@/components/layout/RightSidebar.astro";
import { editorSecrets } from "@/config/editorSecrets";

// 文章前端编辑器（写 / 改 / 删）
// 数据：src/content/posts/<folder>/<slug>.md（GitHub Contents API 直接读写）
const title = "文章编辑器";
const description = "在网页上直接写文章、改文章、删文章，输入 GitHub PAT 即可保存";

const REPO = "FeiZhouHeShang/blog";
const API_TREE_URL = `https://api.github.com/repos/${REPO}/git/trees/main?recursive=1`;
const API_CONTENT = (p: string) =>
	`https://api.github.com/repos/${REPO}/contents/${p}?ref=main`;
const PAT_HELP_URL =
	"https://github.com/settings/personal-access-tokens/new?description=post-editor&contents=write";
const COMMIT_URL_BASE = `https://github.com/${REPO}/commits/main/src/content/posts`;
const EDIT_BASE = `https://github.com/${REPO}/edit/main/`;
// 文章图片目录前缀：/文章/<标题>/
const IMGBED_POST_DIR_PREFIX = "文章";
---

<MainGridLayout title={title} description={description}>
	<LeftSidebar slot="sidebar-left" />
	<RightSidebar slot="sidebar-right" />

	<div class="pe-page-wrapper w-full rounded-(--radius-large) overflow-hidden relative min-h-32" id="pe-root">
		<!-- ========== 编辑器（页面本身就是编辑器，无中间列表） ========== -->
		<!-- ========== 编辑器模态框 ========== -->
		<div
			id="pe-editor"
			data-pe-editor=""
			class="pe-editor-page"
			data-open="true"
			data-imgbed-url={editorSecrets.imageBedUrl}
			data-imgbed-auth={import.meta.env.PUBLIC_IMGBED_UPLOAD_CODE ?? ""}
			data-imgbed-token={import.meta.env.PUBLIC_IMG_UPLOAD_TOKEN ?? ""}
		>
			<div class="pe-editor-panel">
				<!-- 顶部面包屑 + 操作工具栏（仿 fqzlr） -->
				<header class="pe-editor-topbar">
					<div class="pe-topbar-left">
						<button type="button" id="pe-editor-back" class="pe-topbar-btn" title="返回文章列表" aria-label="返回文章列表">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
							<span>返回列表</span>
						</button>
						<span class="pe-topbar-divider"></span>
						<span class="pe-topbar-mode" id="pe-editor-mode-chip">WRITE</span>
						<span class="pe-topbar-title" id="pe-editor-title">编辑文章</span>
					</div>
					<div class="pe-topbar-right">
						<button type="button" id="pe-pat-open" class="pe-topbar-btn" title="配置 GitHub PAT">🔑 密钥</button>
						<span class="pe-topbar-divider"></span>
						<button type="button" id="pe-toolbar-import-md" class="pe-topbar-btn" title="导入本地 .md 文件">📥 导入MD</button>
						<button type="button" id="pe-toolbar-preview" class="pe-topbar-btn" title="预览 Markdown 渲染效果">👁 预览</button>
					<button type="button" id="pe-toolbar-save-draft" class="pe-topbar-btn pe-topbar-btn-save" title="存为本地草稿（标记为草稿，不推送）">💾 存草稿</button>
					<button type="button" id="pe-editor-save" class="pe-topbar-btn pe-topbar-btn-publish" title="保存到本地草稿（标记为已发布）">🚀 存本地</button>
						<button type="button" id="pe-toolbar-delete" class="pe-topbar-btn pe-topbar-btn-delete" title="删除当前文章（不可恢复）" hidden>🗑 删除</button>
					<button type="button" id="pe-editor-close" class="pe-topbar-btn pe-topbar-btn-close" title="返回文章列表" aria-label="返回文章列表">×</button>
					</div>
				</header>

				<!-- 副标题 / 状态行 -->
				<div class="pe-editor-subbar">
					<p class="pe-editor-sub">实时存入<b>本地草稿</b>，最后在右下角「上传中心」统一推送（所有改动合并为 1 次提交）。</p>
					<div class="pe-editor-subbar-right">
						<span id="pe-session-chip" class="pe-session-chip is-lock">🔒 未验证</span>
						<span class="pe-topbar-divider"></span>
						<span id="pe-editor-status" class="pe-editor-status-inline">未验证令牌</span>
					</div>
				</div>

				<!-- 主体两栏：左 = 编辑器（标题 + 正文），右 = 字段侧栏（slug/封面/分类/标签/日期/草稿/置顶/图片） -->
				<div class="pe-editor-main">
					<div class="pe-editor-col">
						<textarea id="pe-f-title" class="pe-title-input" rows="1" placeholder="输入文章标题..." aria-label="文章标题"></textarea>

						<!-- Markdown 工具栏 -->
						<div class="pe-md-toolbar" role="toolbar" aria-label="Markdown 格式工具栏">
							<button type="button" class="pe-md-tb" data-md="bold" title="加粗 Ctrl+B"><b>B</b></button>
							<button type="button" class="pe-md-tb" data-md="italic" title="斜体 Ctrl+I"><i>I</i></button>
							<span class="pe-md-tb-divider"></span>
							<button type="button" class="pe-md-tb" data-md="h1" title="一级标题">H1</button>
							<button type="button" class="pe-md-tb" data-md="h2" title="二级标题">H2</button>
							<button type="button" class="pe-md-tb" data-md="h3" title="三级标题">H3</button>
							<span class="pe-md-tb-divider"></span>
							<button type="button" class="pe-md-tb" data-md="quote" title="引用">❝</button>
							<button type="button" class="pe-md-tb" data-md="code" title="行内代码">‹›</button>
							<button type="button" class="pe-md-tb" data-md="codeblock" title="代码块">⌘</button>
							<button type="button" class="pe-md-tb" data-md="ul" title="无序列表">☰</button>
							<button type="button" class="pe-md-tb" data-md="ol" title="有序列表">1.</button>
							<button type="button" class="pe-md-tb" data-md="link" title="链接 Ctrl+K">🔗</button>
							<button type="button" class="pe-md-tb" data-md="image" title="插入图片">🖼</button>
							<button type="button" class="pe-md-tb" data-md="hr" title="分割线">—</button>
						</div>

						<textarea id="pe-f-body" class="pe-textarea pe-body-input" placeholder="开始写作... 支持 Markdown 语法 快捷键：Ctrl+B 加粗 / Ctrl+I 斜体 / Ctrl+K 链接 / Ctrl+S 保存" aria-label="文章正文 Markdown"></textarea>
				<!-- 预览容器直接套 Markdown.astro 同款 class，确保任何 CSS 改动两侧自动同步 -->
				<div id="pe-preview" class="prose dark:prose-invert prose-base max-w-none! custom-md markdown-bordered pe-preview" hidden></div>
					</div>

					<aside class="pe-editor-side">
						<label class="pe-field">
							<span>🔗 文章 Slug</span>
							<input type="text" id="pe-f-slug" class="pe-input" placeholder="article-slug" />
							<small class="pe-field-hint">留空自动从标题生成</small>
						</label>
						<label class="pe-field">
							<span>🖼 封面图 URL</span>
							<input type="url" id="pe-f-cover" class="pe-input" placeholder="https://example.com/cover.jpg" />
						</label>
						<label class="pe-field">
							<span>📝 文章描述</span>
							<textarea id="pe-f-desc" class="pe-input pe-textarea-sm" rows="2" placeholder="简短的描述文章内容，用于 SEO 列表展示"></textarea>
						</label>
<!-- 标签：三连框 —— ① 已有标签 ② 新建标签 ③ 已选择标签 -->
					<label class="pe-field">
						<span># 标签</span>
						<div class="pe-tags3" data-tags-for="pe-f-tags">
							<div class="pe-tags3-row">
								<div class="pe-tags3-label">① 已有标签（点击选择）</div>
								<div class="pe-tags3-pool" id="pe-tags-pool" role="listbox" aria-label="已有标签"></div>
							</div>
							<div class="pe-tags3-row">
								<div class="pe-tags3-label">② 新建标签（回车或点 + 添加）</div>
								<div class="pe-tags3-input-wrap">
									<input type="text" id="pe-tag-input" class="pe-input" placeholder="输入新标签名后回车或点 +" autocomplete="off" spellcheck="false" />
									<button type="button" id="pe-tag-add-btn" class="pe-tags3-add-btn">+ 添加</button>
								</div>
							</div>
							<div class="pe-tags3-row">
								<div class="pe-tags3-label">③ 已选择标签（点 × 取消）</div>
								<div class="pe-tags3-selected" id="pe-tags-selected"></div>
							</div>
						</div>
						<input type="hidden" id="pe-f-tags" value="" />
						<small class="pe-field-hint">第一排选已有 · 第二排新建 · 第三排已选（点 × 取消关联）</small>
					</label>

					<!-- 分类：combo-box（已移到原分类目录位置；目录展示隐藏，仅保留隐藏字段用于保存） -->
					<label class="pe-field">
						<span>📁 分类</span>
						<div class="pe-combo" data-combo-for="pe-f-cat">
							<input type="text" id="pe-f-cat" class="pe-input pe-combo-input" placeholder="选择或输入新分类..." autocomplete="off" spellcheck="false" />
							<button type="button" class="pe-combo-toggle" aria-label="打开分类列表" tabindex="-1">▾</button>
							<ul class="pe-combo-menu" role="listbox" hidden></ul>
						</div>
						<small class="pe-field-hint">从已有分类中选，或直接输入新分类（目录由前后端自动匹配）</small>
						<input type="hidden" id="pe-f-folder" value="others" />
					</label>
						<label class="pe-field">
							<span>📅 发布日期</span>
							<input type="date" id="pe-f-pub" class="pe-input" />
						</label>
						<div class="pe-field pe-field-flags">
							<label class="pe-check"><input type="checkbox" id="pe-f-draft" /> 📝 草稿（不发布）</label>
							<label class="pe-check"><input type="checkbox" id="pe-f-pinned" /> 📌 置顶文章</label>
						</div>

						<div class="pe-side-divider"></div>

						<!-- 图片上传（方案 A 切换） -->
						<div class="pe-side-block">
							<div class="pe-channel-seg" role="radiogroup" aria-label="上传目标">
								<label class="pe-channel-opt"><input type="radio" name="pe-channel" value="imgbed" checked /> 图床</label>
								<label class="pe-channel-opt"><input type="radio" name="pe-channel" value="repo" /> 仓库本地</label>
							</div>
							<button type="button" id="pe-img-pick" class="pe-editor-btn pe-editor-btn-primary pe-side-btn">🖼 上传图片</button>
							<input type="file" id="pe-img-file" accept="image/*" multiple style="display:none;" />
							<p id="pe-img-tip" class="pe-editor-status pe-side-tip"></p>
							<p class="pe-channel-desc pe-side-desc">图床：直传 CloudFlare 图床。仓库本地（方案 A）：存到 <code>public/assets/images/&lt;标题&gt;/</code>，部署后本地加载、不依赖图床。</p>
							<p id="pe-imgbed-status" class="pe-editor-status" data-imgbed-status></p>
						</div>
					</aside>
				</div>

				<!-- 隐藏的 PAT 面板（默认折叠，点顶部「🔑 密钥」展开） -->
				<section class="pe-pat-panel" id="pe-pat-panel" hidden>
					<div class="pe-pat-row">
						<input type="password" id="pe-editor-pat" placeholder="github_pat_xxxxxxxxxxxxxx" autocomplete="off" spellcheck="false" class="pe-editor-input" />
						<button type="button" id="pe-editor-pat-toggle" class="pe-editor-mini" title="显示/隐藏">👁</button>
						<button type="button" id="pe-editor-pat-validate" class="pe-editor-btn pe-editor-btn-secondary">✅ 验证令牌</button>
						<button type="button" id="pe-editor-pat-clear" class="pe-editor-mini pe-editor-mini-danger" title="退出本次会话">🗑</button>
						<button type="button" id="pe-editor-load" class="pe-editor-btn pe-editor-btn-secondary">🔄 加载远端</button>
					</div>
					<p class="pe-editor-label-tip">本次浏览会话有效（关闭浏览器需重输）· <a href={PAT_HELP_URL} target="_blank" rel="noopener noreferrer" class="pe-editor-link">生成 fine-grained PAT</a></p>
				</section>

				<!-- 标题变更提示 -->
				<div class="pe-title-warn" id="pe-title-warn" style="display:none;"></div>

				<!-- 底部状态条 + 字符计数 -->
				<footer class="pe-editor-foot">
					<div class="pe-editor-foot-left">
						<span id="pe-char-count" class="pe-char-count">0 字</span>
						<span class="pe-topbar-divider"></span>
						<span class="pe-kbd-hint">Ctrl+B 加粗 · Ctrl+I 斜体 · Ctrl+K 链接 · Ctrl+S 保存</span>
					</div>
					<div class="pe-editor-foot-actions">
						<a id="pe-editor-commits" href={COMMIT_URL_BASE} target="_blank" rel="noopener noreferrer" class="pe-editor-link" style="display:none;">查看提交历史</a>
						<p id="pe-editor-foot-status" class="pe-editor-foot-status">准备就绪</p>
					</div>
				</footer>
			</div>
					<input type="file" id="pe-md-import" accept=".md,.markdown,text/markdown" hidden />
		</div>
	</div>
</MainGridLayout>

<style>
	.pe-page-wrapper { padding: 0; max-width: 1280px; margin: 0 auto; }
	.pe-item {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: 0.85rem 1.1rem; border: 1px solid var(--line-divider, #e5e7eb);
		border-radius: var(--radius-large, 12px); background: var(--card-bg, #fff);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.pe-item:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.06); transform: translateY(-1px); }
	.pe-item-main { min-width: 0; }
	.pe-item-title { font-weight: 600; color: var(--deep-text, #111); font-size: 1rem; }
	.pe-item-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; flex-wrap: wrap; }
	.pe-badge { font-size: 0.7rem; padding: 0.1rem 0.45rem; border-radius: 999px; background: var(--btn-card-bg-active, #ececf1); color: var(--content-meta, #6b7280); }
	.pe-badge-pin { background: rgba(245,158,11,0.15); color: #b45309; }
	.pe-badge-draft { background: rgba(107,114,128,0.15); color: #4b5563; }
	.pe-item-date { font-size: 0.72rem; color: var(--content-meta, #6b7280); }
	.pe-item-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }
	.pe-btn {
		font-size: 0.78rem; padding: 0.4rem 0.75rem; border-radius: 8px; cursor: pointer;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg-hover, #f5f5f7); color: var(--deep-text, #111);
		transition: all 0.15s ease; min-height: 44px;
	}
	.pe-btn:hover { background: var(--btn-card-bg-active, #ececf1); }
	.pe-btn-edit { background: var(--primary); color: var(--page-bg); border-color: var(--primary); }
	.pe-btn-edit:hover { filter: brightness(1.15); }
:root.dark .pe-btn-edit:hover { filter: brightness(0.9); }
	.pe-btn-del { background: #fff; color: #e11d48; border-color: rgba(225,29,72,0.3); }
	.pe-btn-del:hover { background: rgba(225,29,72,0.08); }
	.pe-btn-ghost { color: #6b7280; text-decoration: none; display: inline-flex; align-items: center; }

	/* 页面模式（不是 dialog，div 承载） */
	.pe-editor-page {
		width: 100%;
		min-height: calc(100vh - 6rem);
		padding: 0;
		background: var(--card-bg, #fff);
		color: var(--deep-text, #111);
		border-radius: var(--radius-large, 12px);
		overflow: hidden;
		box-shadow: 0 1px 2px rgba(0,0,0,0.04);
	}
	.pe-editor-panel { display: flex; flex-direction: column; min-height: calc(100vh - 6rem); }
	.pe-editor-head {
		display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
		padding: 1.1rem 1.4rem 0.8rem; border-bottom: 1px solid var(--line-divider, #e5e7eb);
	}
	.pe-editor-title { font-size: 1.15rem; font-weight: 700; }
	.pe-editor-sub { font-size: 0.74rem; color: var(--content-meta, #6b7280); margin-top: 0.2rem; }
	.pe-editor-close { font-size: 1.6rem; line-height: 1; background: none; border: none; cursor: pointer; color: var(--content-meta, #6b7280); }
	.pe-editor-token { padding: 0.9rem 1.4rem; border-bottom: 1px solid var(--line-divider, #e5e7eb); }
	.pe-editor-label { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.8rem; font-weight: 600; }
	.pe-editor-label-tip { font-weight: 400; font-size: 0.7rem; color: var(--content-meta, #6b7280); }
	.pe-editor-link { color: var(--primary); text-decoration: none; }
	.pe-editor-token-row { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; }
	.pe-editor-input {
		flex: 1 1 200px; min-width: 160px; padding: 0.5rem 0.7rem; border-radius: 8px;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--page-bg, #fff); color: var(--deep-text, #111);
		font-size: 0.82rem; min-height: 44px;
	}
	.pe-editor-mini {
		min-width: 44px; min-height: 44px; padding: 0 0.6rem; border-radius: 8px; cursor: pointer;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg-hover, #f5f5f7); color: var(--deep-text, #111);
	}
	.pe-editor-mini-danger:hover { background: rgba(244,63,94,0.1); border-color: rgba(244,63,94,0.4); }
	.pe-editor-btn {
		min-height: 44px; padding: 0.5rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.82rem;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg-hover, #f5f5f7); color: var(--deep-text, #111);
	}
	.pe-editor-btn-secondary { background: #eef2ff; border-color: #c7d2fe; color: #4338ca; }
	.pe-editor-btn-primary { background: var(--primary); border-color: var(--primary); color: var(--page-bg); font-weight: 600; }
	.pe-editor-btn-primary:hover { filter: brightness(1.15); }
:root.dark .pe-editor-btn-primary:hover { filter: brightness(0.9); }
	.pe-editor-token-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
	.pe-session-chip { font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 999px; border: 1px solid transparent; font-weight: 500; }
	.pe-session-chip.is-ok { color: #047857; background: rgba(16,185,129,0.12); border-color: rgba(16,185,129,0.35); }
	.pe-session-chip.is-lock { color: #b45309; background: rgba(245,158,11,0.12); border-color: rgba(245,158,11,0.35); }
	.pe-editor-status { font-size: 0.72rem; margin: 0.5rem 0 0; color: var(--content-meta, #6b7280); }
	.pe-editor-status.is-error { color: #f43f5e; }
	.pe-editor-status.is-ok { color: #10b981; }

	.pe-editor-form { padding: 1rem 1.4rem; overflow-y: auto; flex: 1 1 auto; }
	.pe-form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem 1rem; }
	.pe-field { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.74rem; color: var(--content-meta, #6b7280); }
	.pe-field-title { grid-column: 1 / -1; }
	.pe-field-body { grid-column: 1 / -1; }
	.pe-field code { background: rgba(99,102,241,0.1); padding: 0 0.3rem; border-radius: 4px; color: var(--primary); }
	.pe-input {
		padding: 0.5rem 0.7rem; border-radius: 8px; border: 1px solid var(--line-divider, #e5e7eb);
		background: var(--page-bg, #fff); color: var(--deep-text, #111); font-size: 0.85rem; min-height: 44px;
	}
	.pe-textarea { padding: 0.6rem 0.7rem; border-radius: 8px; border: 1px solid var(--line-divider, #e5e7eb); background: var(--page-bg, #fff); color: var(--deep-text, #111); font-size: 0.85rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; line-height: 1.6; resize: vertical; }
	.pe-field-flags { flex-direction: row; gap: 1rem; align-items: center; }
	.pe-check { display: flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--deep-text, #111); }
	.pe-title-warn { grid-column: 1 / -1; margin: 0.4rem 0 0; padding: 0.6rem 0.8rem; border-radius: 8px; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.35); color: #b45309; font-size: 0.76rem; }
	.pe-img-row { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.8rem; flex-wrap: wrap; }

	/* 方案 A：上传目标切换（图床 / 仓库本地） */
	.pe-channel-seg { display: inline-flex; border: 1px solid var(--line-divider, #e5e7eb); border-radius: 8px; overflow: hidden; flex-shrink: 0; }
	.pe-channel-opt { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.78rem; padding: 0.4rem 0.65rem; cursor: pointer; color: var(--content-meta, #6b7280); user-select: none; background: var(--btn-card-bg-hover, #f5f5f7); transition: all 0.15s; }
	.pe-channel-opt:not(:last-child) { border-right: 1px solid var(--line-divider, #e5e7eb); }
	.pe-channel-opt:has(input:checked) { background: var(--primary); color: var(--page-bg); }
	.pe-channel-opt input { accent-color: currentColor; margin: 0; width: 0.95rem; height: 0.95rem; }
	.pe-channel-desc { margin: 0.4rem 0 0; line-height: 1.55; }
	.pe-channel-desc code { background: rgba(99,102,241,0.1); padding: 0 0.3rem; border-radius: 4px; color: var(--primary); }

	.pe-editor-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.4rem; border-top: 1px solid var(--line-divider, #e5e7eb); }
	.pe-editor-foot-status { font-size: 0.74rem; color: var(--content-meta, #6b7280); margin: 0; flex: 1; }
	.pe-editor-foot-actions { display: flex; gap: 0.5rem; align-items: center; }

	/* ===== fqzlr 风格全屏编辑器 ===== */
	/* 顶栏 */
	.pe-editor-topbar {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: 0.7rem 1.4rem; border-bottom: 1px solid var(--line-divider, #e5e7eb);
		background: var(--card-bg, #fff); flex-shrink: 0;
	}
	.pe-topbar-left, .pe-topbar-right { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
	.pe-topbar-divider { width: 1px; height: 18px; background: var(--line-divider, #e5e7eb); margin: 0 0.25rem; }
	.pe-topbar-mode {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.7rem;
		color: var(--content-meta, #6b7280); letter-spacing: 0.2em;
	}
	.pe-topbar-title { font-size: 0.95rem; font-weight: 600; color: var(--deep-text, #111); }
	.pe-topbar-btn {
		display: inline-flex; align-items: center; gap: 0.35rem;
		padding: 0.45rem 0.8rem; min-height: 36px;
		border-radius: 8px; cursor: pointer; font-size: 0.82rem; font-weight: 500;
		border: 1px solid var(--line-divider, #e5e7eb);
		background: var(--btn-card-bg-hover, #f5f5f7);
		color: var(--deep-text, #111);
		transition: all 0.15s ease;
	}
	.pe-topbar-btn:hover { background: var(--btn-card-bg-active, #ececf1); }
	.pe-topbar-btn-save { background: var(--btn-card-bg-hover, #f5f5f7); color: var(--primary, #4f46e5); border-color: var(--line-divider, #e5e7eb); }
	.pe-topbar-btn-publish { background: var(--primary); color: var(--page-bg); border-color: var(--primary); font-weight: 600; }
	.pe-topbar-btn-publish:hover { filter: brightness(1.15); }
:root.dark .pe-topbar-btn-publish:hover { filter: brightness(0.9); }
	.pe-topbar-btn-delete {
		background: transparent;
		color: #e11d48;
		border-color: rgba(225,29,72,0.25);
	}
	.pe-topbar-btn-delete:hover {
		background: rgba(225,29,72,0.08);
		border-color: rgba(225,29,72,0.5);
		color: #e11d48;
	}
	.pe-topbar-btn-delete[hidden] { display: none !important; }
	.pe-topbar-btn-close { padding: 0.45rem 0.7rem; font-size: 1.2rem; line-height: 1; }

	/* 副标题 / 状态行 */
	.pe-editor-subbar {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: 0.55rem 1.4rem; border-bottom: 1px solid var(--line-divider, #e5e7eb);
		background: var(--card-bg, #fff); flex-shrink: 0;
	}
	.pe-editor-subbar-right { display: flex; align-items: center; gap: 0.5rem; }
