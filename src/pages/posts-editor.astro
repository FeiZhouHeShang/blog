	.pe-editor-status-inline.is-error { color: #f43f5e; }
	.pe-editor-status-inline.is-ok { color: #10b981; }

	/* 主体两栏 */
	.pe-editor-main {
		display: grid; grid-template-columns: minmax(0, 1fr) 320px;
		gap: 0; flex: 1 1 auto; min-height: 0;
	}

	/* 左栏：编辑器 */
	.pe-editor-col { display: flex; flex-direction: column; min-width: 0; padding: 0; overflow: hidden; }
	.pe-title-input {
		width: 100%; box-sizing: border-box;
		padding: 1.4rem 1.6rem 0.6rem;
		border: none; outline: none; resize: none; background: transparent;
		font-size: 1.6rem; font-weight: 700; color: var(--deep-text, #111);
		font-family: inherit; line-height: 1.4; min-height: 64px;
		overflow: hidden;
	}
	.pe-title-input::placeholder { color: var(--content-meta, #9ca3af); font-weight: 500; }
	.pe-md-toolbar {
		display: flex; align-items: center; gap: 0.15rem;
		padding: 0.4rem 1.4rem; border-top: 1px solid var(--line-divider, #e5e7eb);
		border-bottom: 1px solid var(--line-divider, #e5e7eb);
