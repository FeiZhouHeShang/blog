---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LeftSidebar from "@/components/layout/LeftSidebar.astro";
import RightSidebar from "@/components/layout/RightSidebar.astro";
import { postsIndex, type PostIndexItem } from "@/data/posts-index";
import { editorSecrets } from "@/config/editorSecrets";

// 文章前端编辑器（写 / 改 / 删）
// 数据：src/content/posts/<folder>/<slug>.md（GitHub Contents API 直接读写）
const title = "文章编辑器";
const description = "在网页上直接写文章、改文章、删文章，输入 GitHub PAT 即可保存";

const REPO = "FeiZhouHeShang/blog";
const API_TREE_URL = `https://api.github.com/repos/${REPO}/git/trees/main?recursive=1`;
const API_CONTENT = (p: string) =>
	`https://api.github.com/repos/${REPO}/contents/${p}?ref=main`;
const PAT_HELP_URL =
	"https://github.com/settings/personal-access-tokens/new?description=post-editor&contents=write";
const COMMIT_URL_BASE = `https://github.com/${REPO}/commits/main/src/content/posts`;
const EDIT_BASE = `https://github.com/${REPO}/edit/main/`;
// 文章图片目录前缀：/文章/<标题>/
const IMGBED_POST_DIR_PREFIX = "文章";
---

<MainGridLayout title={title} description={description}>
	<LeftSidebar slot="sidebar-left" />
	<RightSidebar slot="sidebar-right" />

	<div class="pe-page-wrapper w-full rounded-(--radius-large) overflow-hidden relative min-h-32" id="pe-root">
		<div class="pe-header relative w-full mb-8 flex flex-wrap items-end justify-between gap-4">
			<div>
				<h1 class="text-2xl font-bold tracking-tight text-[var(--deep-text)]">文章编辑器</h1>
				<p class="mt-1 text-sm text-[var(--content-meta)]">
					共 {postsIndex.length} 篇（种子列表）· 网页上直接写 / 改 / 删，输入 GitHub PAT 即保存到仓库并部署
				</p>
			</div>
			<div class="flex items-center gap-2">
				<button
					type="button"
					id="pe-open-editor"
					class="btn-card inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm hover:shadow-md transition-all duration-150"
				>
					✏️ 编辑文章
				</button>
			</div>
		</div>

		<!-- 文章列表 -->
		<div class="pe-list flex flex-col gap-3" data-pe-list="">
			{
				postsIndex.map((p) => (
					<article class="pe-item" data-pe-item="" data-path={p.path}>
						<div class="pe-item-main">
							<div class="pe-item-title">{p.title}</div>
							<div class="pe-item-meta">
								<span class="pe-badge">{p.folder}</span>
								{p.pinned && <span class="pe-badge pe-badge-pin">📌 置顶</span>}
								{p.draft && <span class="pe-badge pe-badge-draft">草稿</span>}
								<span class="pe-item-date">{p.published}</span>
							</div>
						</div>
						<div class="pe-item-actions">
							<button type="button" class="pe-btn pe-btn-edit" data-pe-edit={p.path}>编辑</button>
							<button type="button" class="pe-btn pe-btn-del" data-pe-del={p.path}>删除</button>
							<a
								href={EDIT_BASE + p.path}
								target="_blank"
								rel="noopener noreferrer"
								class="pe-btn pe-btn-ghost"
							>GitHub</a>
						</div>
					</article>
				))
			}
		</div>

		<div class="pe-empty py-16 text-center text-[var(--content-meta)]" data-pe-empty="" style="display:none;">
			暂无文章
		</div>

		<!-- ========== 编辑器模态框 ========== -->
		<dialog
			id="pe-editor"
			data-pe-editor=""
			class="pe-editor-dialog"
			data-imgbed-url={editorSecrets.imageBedUrl}
			data-imgbed-auth={import.meta.env.PUBLIC_IMGBED_UPLOAD_CODE ?? ""}
			data-imgbed-token={import.meta.env.PUBLIC_IMG_UPLOAD_TOKEN ?? ""}
		>
			<div class="pe-editor-panel">
				<header class="pe-editor-head">
					<div>
						<h2 class="pe-editor-title" id="pe-editor-title">编辑文章</h2>
						<p class="pe-editor-sub">GitHub PAT 校验后，本次浏览内保存/删除无需再次输入；图片直传图床按标题归档</p>
					</div>
					<button type="button" id="pe-editor-close" class="pe-editor-close" aria-label="关闭">×</button>
				</header>

				<!-- 令牌区 -->
				<section class="pe-editor-token">
					<label class="pe-editor-label">
						<span>GitHub Personal Access Token</span>
						<span class="pe-editor-label-tip">
							本次浏览会话有效（关闭浏览器需重输）
							· <a href={PAT_HELP_URL} target="_blank" rel="noopener noreferrer" class="pe-editor-link">生成 fine-grained PAT</a>
						</span>
					</label>
					<div class="pe-editor-token-row">
						<input type="password" id="pe-editor-pat" placeholder="github_pat_xxxxxxxxxxxxxx" autocomplete="off" spellcheck="false" class="pe-editor-input" />
						<button type="button" id="pe-editor-pat-toggle" class="pe-editor-mini" title="显示/隐藏">👁</button>
						<button type="button" id="pe-editor-pat-validate" class="pe-editor-btn pe-editor-btn-secondary">✅ 验证令牌</button>
						<button type="button" id="pe-editor-pat-clear" class="pe-editor-mini pe-editor-mini-danger" title="退出本次会话">🗑</button>
						<button type="button" id="pe-editor-load" class="pe-editor-btn pe-editor-btn-secondary">🔄 加载远端</button>
					</div>
					<div class="pe-editor-token-meta">
						<span id="pe-session-chip" class="pe-session-chip is-lock">🔒 未验证</span>
						<span class="pe-editor-label-tip">验证后，本次浏览内保存/删除均无需再次输入</span>
					</div>
					<p id="pe-editor-status" class="pe-editor-status">未验证令牌</p>
				</section>

				<!-- 表单区 -->
				<section class="pe-editor-form" data-pe-form="">
					<div class="pe-form-grid">
						<label class="pe-field pe-field-title">
							<span>标题（决定图片目录 <code>/文章/&lt;标题&gt;/</code>）</span>
							<input type="text" id="pe-f-title" class="pe-input" placeholder="例如：笑嘻嘻" />
						</label>
						<label class="pe-field pe-field-folder">
							<span>分类目录</span>
							<select id="pe-f-folder" class="pe-input">
								<option value="ai">ai</option>
								<option value="others">others</option>
								<option value="projects">projects</option>
							</select>
						</label>
						<label class="pe-field pe-field-slug">
							<span>文件名（slug，仅英文/数字/连字符）</span>
							<input type="text" id="pe-f-slug" class="pe-input" placeholder="my-post" />
						</label>
						<label class="pe-field pe-field-cat">
							<span>分类标签（展示用）</span>
							<input type="text" id="pe-f-cat" class="pe-input" placeholder="学习文档" />
						</label>
						<label class="pe-field pe-field-desc">
							<span>描述</span>
							<input type="text" id="pe-f-desc" class="pe-input" placeholder="一句话简介" />
						</label>
						<label class="pe-field pe-field-tags">
							<span>标签（逗号分隔）</span>
							<input type="text" id="pe-f-tags" class="pe-input" placeholder="博客, 教程" />
						</label>
						<label class="pe-field pe-field-pub">
							<span>发布日期</span>
							<input type="date" id="pe-f-pub" class="pe-input" />
						</label>
						<label class="pe-field pe-field-upd">
							<span>更新日期</span>
							<input type="date" id="pe-f-upd" class="pe-input" />
						</label>
						<div class="pe-field pe-field-flags">
							<label class="pe-check"><input type="checkbox" id="pe-f-pinned" /> 置顶</label>
							<label class="pe-check"><input type="checkbox" id="pe-f-draft" /> 草稿</label>
						</div>
					</div>

					<!-- 标题变更提示 -->
					<div class="pe-title-warn" id="pe-title-warn" style="display:none;"></div>

					<!-- 正文 -->
					<label class="pe-field pe-field-body">
						<span>正文（Markdown）</span>
						<textarea id="pe-f-body" class="pe-textarea" rows="14" placeholder="支持 Markdown…"></textarea>
					</label>

					<!-- 图片上传 -->
					<div class="pe-img-row">
						<button type="button" id="pe-img-pick" class="pe-editor-btn pe-editor-btn-primary">🖼 上传图片到 /文章/&lt;标题&gt;/</button>
						<input type="file" id="pe-img-file" accept="image/*" multiple style="display:none;" />
						<span id="pe-img-tip" class="pe-editor-status"></span>
					</div>
					<p id="pe-imgbed-status" class="pe-editor-status" data-imgbed-status=""></p>
				</section>

				<footer class="pe-editor-foot">
					<p id="pe-editor-foot-status" class="pe-editor-foot-status">准备就绪</p>
					<div class="pe-editor-foot-actions">
						<a id="pe-editor-commits" href={COMMIT_URL_BASE} target="_blank" rel="noopener noreferrer" class="pe-editor-link" style="display:none;">查看提交历史</a>
						<button type="button" id="pe-editor-cancel" class="pe-editor-btn">关闭</button>
						<button type="button" id="pe-editor-save" class="pe-editor-btn pe-editor-btn-primary">💾 保存到 GitHub</button>
					</div>
				</footer>
			</div>
		</dialog>
	</div>
</MainGridLayout>

<style>
	.pe-page-wrapper { padding: 1rem 0.25rem; }
	.pe-header h1 { letter-spacing: -0.01em; }
	.pe-list { gap: 0.6rem; }
	.pe-item {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: 0.85rem 1.1rem; border: 1px solid var(--line-divider, #e5e7eb);
		border-radius: var(--radius-large, 12px); background: var(--card-bg, #fff);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.pe-item:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.06); transform: translateY(-1px); }
	.pe-item-main { min-width: 0; }
	.pe-item-title { font-weight: 600; color: var(--deep-text, #111); font-size: 1rem; }
	.pe-item-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; flex-wrap: wrap; }
	.pe-badge { font-size: 0.7rem; padding: 0.1rem 0.45rem; border-radius: 999px; background: rgba(99,102,241,0.12); color: #4f46e5; }
	.pe-badge-pin { background: rgba(245,158,11,0.15); color: #b45309; }
	.pe-badge-draft { background: rgba(107,114,128,0.15); color: #4b5563; }
	.pe-item-date { font-size: 0.72rem; color: var(--content-meta, #6b7280); }
	.pe-item-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }
	.pe-btn {
		font-size: 0.78rem; padding: 0.4rem 0.75rem; border-radius: 8px; cursor: pointer;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg, #f5f5f7); color: var(--deep-text, #111);
		transition: all 0.15s ease; min-height: 44px;
	}
	.pe-btn:hover { background: var(--btn-card-bg-hover, #ececf1); }
	.pe-btn-edit { background: #4f46e5; color: #fff; border-color: #4f46e5; }
	.pe-btn-edit:hover { background: #4338ca; }
	.pe-btn-del { background: #fff; color: #e11d48; border-color: rgba(225,29,72,0.3); }
	.pe-btn-del:hover { background: rgba(225,29,72,0.08); }
	.pe-btn-ghost { color: #6b7280; text-decoration: none; display: inline-flex; align-items: center; }

	/* 模态框 */
	.pe-editor-dialog {
		width: min(880px, 96vw); max-height: 94vh; padding: 0; border: none;
		border-radius: var(--radius-large, 16px); background: var(--card-bg, #fff);
		box-shadow: 0 24px 70px rgba(0,0,0,0.3); color: var(--deep-text, #111);
	}
	.pe-editor-dialog::backdrop { background: rgba(15,23,42,0.55); backdrop-filter: blur(2px); }
	.pe-editor-panel { display: flex; flex-direction: column; max-height: 94vh; }
	.pe-editor-head {
		display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
		padding: 1.1rem 1.4rem 0.8rem; border-bottom: 1px solid var(--line-divider, #e5e7eb);
	}
	.pe-editor-title { font-size: 1.15rem; font-weight: 700; }
	.pe-editor-sub { font-size: 0.74rem; color: var(--content-meta, #6b7280); margin-top: 0.2rem; }
	.pe-editor-close { font-size: 1.6rem; line-height: 1; background: none; border: none; cursor: pointer; color: var(--content-meta, #6b7280); }
	.pe-editor-token { padding: 0.9rem 1.4rem; border-bottom: 1px solid var(--line-divider, #e5e7eb); }
	.pe-editor-label { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.8rem; font-weight: 600; }
	.pe-editor-label-tip { font-weight: 400; font-size: 0.7rem; color: var(--content-meta, #6b7280); }
	.pe-editor-link { color: #4f46e5; text-decoration: none; }
	.pe-editor-token-row { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; }
	.pe-editor-input {
		flex: 1 1 200px; min-width: 160px; padding: 0.5rem 0.7rem; border-radius: 8px;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--bg-main, #fff); color: var(--deep-text, #111);
		font-size: 0.82rem; min-height: 44px;
	}
	.pe-editor-mini {
		min-width: 44px; min-height: 44px; padding: 0 0.6rem; border-radius: 8px; cursor: pointer;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg, #f5f5f7); color: var(--deep-text, #111);
	}
	.pe-editor-mini-danger:hover { background: rgba(244,63,94,0.1); border-color: rgba(244,63,94,0.4); }
	.pe-editor-btn {
		min-height: 44px; padding: 0.5rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.82rem;
		border: 1px solid var(--line-divider, #e5e7eb); background: var(--btn-card-bg, #f5f5f7); color: var(--deep-text, #111);
	}
	.pe-editor-btn-secondary { background: #eef2ff; border-color: #c7d2fe; color: #4338ca; }
	.pe-editor-btn-primary { background: #4f46e5; border-color: #4f46e5; color: #fff; font-weight: 600; }
	.pe-editor-btn-primary:hover { background: #4338ca; }
	.pe-editor-token-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
	.pe-session-chip { font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 999px; border: 1px solid transparent; font-weight: 500; }
	.pe-session-chip.is-ok { color: #047857; background: rgba(16,185,129,0.12); border-color: rgba(16,185,129,0.35); }
	.pe-session-chip.is-lock { color: #b45309; background: rgba(245,158,11,0.12); border-color: rgba(245,158,11,0.35); }
	.pe-editor-status { font-size: 0.72rem; margin: 0.5rem 0 0; color: var(--content-meta, #6b7280); }
	.pe-editor-status.is-error { color: #f43f5e; }
	.pe-editor-status.is-ok { color: #10b981; }

	.pe-editor-form { padding: 1rem 1.4rem; overflow-y: auto; flex: 1 1 auto; }
	.pe-form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem 1rem; }
	.pe-field { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.74rem; color: var(--content-meta, #6b7280); }
	.pe-field-title { grid-column: 1 / -1; }
	.pe-field-body { grid-column: 1 / -1; }
	.pe-field code { background: rgba(99,102,241,0.1); padding: 0 0.3rem; border-radius: 4px; color: #4f46e5; }
	.pe-input {
		padding: 0.5rem 0.7rem; border-radius: 8px; border: 1px solid var(--line-divider, #e5e7eb);
		background: var(--bg-main, #fff); color: var(--deep-text, #111); font-size: 0.85rem; min-height: 44px;
	}
	.pe-textarea { padding: 0.6rem 0.7rem; border-radius: 8px; border: 1px solid var(--line-divider, #e5e7eb); background: var(--bg-main, #fff); color: var(--deep-text, #111); font-size: 0.85rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; line-height: 1.6; resize: vertical; }
	.pe-field-flags { flex-direction: row; gap: 1rem; align-items: center; }
	.pe-check { display: flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--deep-text, #111); }
	.pe-title-warn { grid-column: 1 / -1; margin: 0.4rem 0 0; padding: 0.6rem 0.8rem; border-radius: 8px; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.35); color: #b45309; font-size: 0.76rem; }
	.pe-img-row { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.8rem; flex-wrap: wrap; }

	.pe-editor-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.4rem; border-top: 1px solid var(--line-divider, #e5e7eb); }
	.pe-editor-foot-status { font-size: 0.74rem; color: var(--content-meta, #6b7280); margin: 0; flex: 1; }
	.pe-editor-foot-actions { display: flex; gap: 0.5rem; align-items: center; }

	@media (max-width: 640px) {
		.pe-form-grid { grid-template-columns: 1fr; }
		.pe-item { flex-direction: column; align-items: stretch; }
		.pe-item-actions { justify-content: flex-end; }
	}
</style>

<script>
	// ===================== 文章前端编辑器逻辑 =====================
	(function () {
		var $ = function (id) { return document.getElementById(id); };
		var REPO = "FeiZhouHeShang/blog";
		var API_TREE_URL = "https://api.github.com/repos/" + REPO + "/git/trees/main?recursive=1";
		var API_CONTENT = function (p) { return "https://api.github.com/repos/" + REPO + "/contents/" + p + "?ref=main"; };
		var IMGBED_POST_DIR_PREFIX = "文章";
		var PAT_STORAGE_KEY = "__pe_session_pat__";

		// 图床配置（构建时注入）
		var peDialog = $("pe-editor");
		var IMGBED_URL = (peDialog && peDialog.getAttribute("data-imgbed-url")) || "";
		var IMGBED_AUTH = (peDialog && peDialog.getAttribute("data-imgbed-auth")) || "";
		var IMGBED_API_TOKEN = (peDialog && peDialog.getAttribute("data-imgbed-token")) || "";

		// ===== 状态 =====
		var state = {
			posts: [],          // { path, folder, slug, title, sha, ...meta }
			editingPath: null,  // 正在编辑的文件仓库路径（null=新建）
			editingSha: null,   // 文件 blob sha（新建为 null）
			originalTitle: "",  // 编辑前的标题（用于变更提示）
			isNew: true,
			saving: false,
		};
		// 图片去重：本次会话已上传哈希 -> URL
		var uploadedHashes = {};

		// ===== 工具 =====
		function setStatus(el, msg, kind) {
			if (!el) return;
			el.textContent = msg || "";
			el.classList.remove("is-error", "is-ok");
			if (kind) el.classList.add("is-" + kind);
		}
		function base64ToUtf8(b64) {
			try { return decodeURIComponent(escape(atob(b64.replace(/\s/g, "")))); }
			catch (_e) { return atob(b64.replace(/\s/g, "")); }
		}
		function utf8ToBase64(str) {
			return btoa(unescape(encodeURIComponent(str)));
		}
		function escHtml(s) {
			return String(s).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}
		function slugify(s) {
			var out = String(s).toLowerCase().trim().replace(/\s+/g, "-").replace(/[^a-z0-9\-]/g, "");
			return out || ("post-" + new Date().toISOString().slice(0, 10));
		}
		function nowDate() { return new Date().toISOString().slice(0, 10); }

		// ===== 会话令牌 =====
		function getPat() { return sessionStorage.getItem(PAT_STORAGE_KEY) || ""; }
		function setPat(v) { if (v) sessionStorage.setItem(PAT_STORAGE_KEY, v); else sessionStorage.removeItem(PAT_STORAGE_KEY); }
		async function validatePat(token) {
			var r = await fetch("https://api.github.com/user", {
				headers: { Authorization: "Bearer " + token, Accept: "application/vnd.github+json" },
			});
			if (!r.ok) {
				var err = await r.json().catch(function () { return {}; });
				throw new Error("令牌无效（" + r.status + "：" + (err.message || r.statusText) + "）");
			}
			return true;
		}
		function renderSessionState() {
			var chip = $("pe-session-chip");
			if (!chip) return;
			if (getPat()) { chip.textContent = "🔓 本次浏览已验证"; chip.className = "pe-session-chip is-ok"; }
			else { chip.textContent = "🔒 未验证"; chip.className = "pe-session-chip is-lock"; }
		}

		// ===== 图床上传 =====
		function extractImgUrl(data) {
			if (!data) return "";
			if (typeof data === "string") return data;
			if (Array.isArray(data)) {
				var f = data[0];
				if (!f || typeof f !== "object") return "";
				return f.src || f.url || f.link || f.absolute_url || f.full_url || f.pathname || f.publicUrl || "";
			}
			var inner = data.data;
			if (inner && typeof inner === "object") {
				var arr = Array.isArray(inner) ? inner : [inner];
				var ff = arr[0];
				if (ff && typeof ff === "object") return ff.src || ff.url || ff.publicUrl || "";
			}
			return data.src || data.url || data.publicUrl || "";
		}
		async function hashFile(file) {
			try {
				var buf = await file.arrayBuffer();
				var digest = await crypto.subtle.digest("SHA-256", buf);
				return Array.from(new Uint8Array(digest)).map(function (b) { return b.toString(16).padStart(2, "0"); }).join("");
			} catch (_e) { return ""; }
		}
		async function uploadToImgbed(file, folder) {
			var fd = new FormData();
			fd.append("file", file);
			var base = (IMGBED_URL || "").replace(/\/+$/, "");
			var url = base + "/upload?returnFormat=full&uploadNameType=origin";
			if (folder) url += "&uploadFolder=" + encodeURIComponent(folder);
			var headers = { Accept: "application/json" };
			// 单令牌（list+upload）优先 Bearer；否则 authCode 兜底
			if (IMGBED_API_TOKEN) headers["Authorization"] = "Bearer " + IMGBED_API_TOKEN;
			else if (IMGBED_AUTH) url += "&authCode=" + encodeURIComponent(IMGBED_AUTH);
			var r = await fetch(url, { method: "POST", body: fd, headers: headers });
			if (!r.ok) throw new Error("图床上传失败 " + r.status);
			var data = await r.json().catch(function () { return null; });
			var u = extractImgUrl(data);
			if (!u) throw new Error("无法从图床响应解析图片 URL");
			return u;
		}
		async function handleImgUpload() {
			var fileInput = $("pe-img-file");
			if (!fileInput || !fileInput.files || !fileInput.files.length) return;
			var title = ($("pe-f-title").value || "").trim();
			if (!title) { setStatus($("pe-img-tip"), "⚠️ 请先填写标题，图片才能归到 /文章/<标题>/ 目录", "is-error"); return; }
			var folder = IMGBED_POST_DIR_PREFIX + "/" + title;
			var files = Array.from(fileInput.files);
			var tip = $("pe-img-tip");
			var done = 0, reused = 0;
			setStatus(tip, "上传中 0/" + files.length, "");
			try {
				for (var i = 0; i < files.length; i++) {
					var file = files[i];
					var h = await hashFile(file);
					if (h && uploadedHashes[h]) {
						insertImageMarkdown(uploadedHashes[h]);
						reused++; setStatus(tip, "复用 " + reused + " · 上传 " + done + "/" + files.length, "is-ok");
						continue;
					}
					var url = await uploadToImgbed(file, folder);
					if (h) uploadedHashes[h] = url;
					insertImageMarkdown(url);
					done++; setStatus(tip, "上传 " + done + "/" + files.length + (reused ? " · 复用 " + reused : ""), "is-ok");
				}
				setStatus(tip, "已上传 " + done + " 张" + (reused ? " · 复用 " + reused + " 张" : ""), "is-ok");
			} catch (e) {
				setStatus(tip, "❌ " + e.message, "is-error");
			} finally {
				fileInput.value = "";
			}
		}
		function insertImageMarkdown(url) {
			var ta = $("pe-f-body");
			if (!ta) return;
			var md = "\n![](" + url + ")\n";
			var start = ta.selectionStart || ta.value.length;
			ta.value = ta.value.slice(0, start) + md + ta.value.slice(start);
			ta.focus();
			ta.selectionStart = ta.selectionEnd = start + md.length;
		}

		// ===== 读取现有文章 =====
		function splitFrontmatter(raw) {
			var m = raw.match(/^---\s*\r?\n([\s\S]*?)\r?\n---\s*\r?\n?([\s\S]*)$/);
			if (!m) return { fm: "", body: raw };
			return { fm: m[1], body: m[2] || "" };
		}
		function parseFm(fm) {
			var out = {};
			fm.split(/\r?\n/).forEach(function (line) {
				var mm = line.match(/^([A-Za-z_][\w-]*)\s*:\s*(.*)$/);
				if (!mm) return;
				var k = mm[1], v = mm[2].trim();
				if (v.startsWith("[") && v.endsWith("]")) {
					out[k] = v.slice(1, -1).split(",").map(function (s) { return s.trim().replace(/^["']|["']$/g, ""); }).filter(Boolean);
				} else if (v === "true") out[k] = true;
				else if (v === "false") out[k] = false;
				else out[k] = v.replace(/^["']|["']$/g, "");
			});
			return out;
		}
		function buildMarkdown(fm, body) {
			var lines = Object.keys(fm).map(function (k) {
				var v = fm[k];
				if (Array.isArray(v)) return k + ": [" + v.map(function (x) { return '"' + x + '"'; }).join(", ") + "]";
				if (typeof v === "boolean") return k + ": " + (v ? "true" : "false");
				return k + ': "' + String(v).replace(/"/g, '\\"') + '"';
			});
			return "---\n" + lines.join("\n") + "\n---\n\n" + body + "\n";
		}

		// ===== 渲染列表 =====
		function renderList() {
			var listEl = $("pe-root").querySelector("[data-pe-list]");
			if (!listEl) return;
			listEl.innerHTML = state.posts.map(function (p) {
				var badges = '<span class="pe-badge">' + escHtml(p.folder) + "</span>" +
					(p.pinned ? '<span class="pe-badge pe-badge-pin">📌 置顶</span>' : "") +
					(p.draft ? '<span class="pe-badge pe-badge-draft">草稿</span>' : "") +
					'<span class="pe-item-date">' + escHtml(p.published || "") + "</span>";
				return '<article class="pe-item" data-pe-item="" data-path="' + escHtml(p.path) + '">' +
					'<div class="pe-item-main"><div class="pe-item-title">' + escHtml(p.title || p.slug) + "</div>" +
					'<div class="pe-item-meta">' + badges + "</div></div>" +
					'<div class="pe-item-actions">' +
					'<button type="button" class="pe-btn pe-btn-edit" data-pe-edit="' + escHtml(p.path) + '">编辑</button>' +
					'<button type="button" class="pe-btn pe-btn-del" data-pe-del="' + escHtml(p.path) + '">删除</button>' +
					'<a href="https://github.com/' + REPO + "/edit/main/" + encodeURIComponent(p.path) + '" target="_blank" rel="noopener noreferrer" class="pe-btn pe-btn-ghost">GitHub</a>' +
					"</div></article>";
			}).join("");
			var empty = $("pe-root").querySelector("[data-pe-empty]");
			if (empty) empty.style.display = state.posts.length === 0 ? "" : "none";
		}

		// ===== 加载远端（GitHub tree）=====
		async function loadRemote() {
			var token = getPat();
			if (!token) { setStatus($("pe-editor-status"), "请先验证 GitHub PAT", "is-error"); return; }
			setStatus($("pe-editor-status"), "正在从 GitHub 加载文章树...", "");
			try {
				var r = await fetch(API_TREE_URL, { headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token } });
				if (!r.ok) { var e = await r.json().catch(function(){return{};}); throw new Error("加载失败 " + r.status + "：" + (e.message || r.statusText)); }
				var data = await r.json();
				var posts = (data.tree || [])
					.filter(function (n) { return n.path.startsWith("src/content/posts/") && n.path.endsWith(".md"); })
					.map(function (n) {
						var rel = n.path.slice("src/content/posts/".length);
						var parts = rel.split("/");
						var folder = parts.length > 1 ? parts[0] : "";
						var slug = parts[parts.length - 1].replace(/\.md$/, "");
						return { path: n.path, folder: folder, slug: slug, title: slug, sha: n.sha, published: "", pinned: false, draft: false };
					});
				// 用种子索引补全标题等元信息
				var seedMap = {};
				(state.seed || []).forEach(function (s) { seedMap[s.path] = s; });
				posts.forEach(function (p) { var s = seedMap[p.path]; if (s) { p.title = s.title; p.published = s.published; p.pinned = s.pinned; p.draft = s.draft; } });
				state.posts = posts;
				setStatus($("pe-editor-status"), "已加载 " + posts.length + " 篇 · SHA 树已就绪", "is-ok");
				renderList();
			} catch (e) {
				setStatus($("pe-editor-status"), "❌ " + e.message, "is-error");
			}
		}

		// ===== 打开编辑器 / 编辑某篇 =====
		function openEditor(path) {
			var dlg = $("pe-editor");
			if (!dlg) return;
			if (typeof dlg.showModal === "function") dlg.showModal(); else dlg.setAttribute("open", "");
			renderSessionState();
			if (path) editPost(path); else newPost();
		}
		function newPost() {
			state.isNew = true; state.editingPath = null; state.editingSha = null; state.originalTitle = "";
			$("pe-editor-title").textContent = "写新文章";
			clearForm();
			hideTitleWarn();
			setStatus($("pe-editor-foot-status"), "填写信息后保存即创建新文章", "");
		}
		async function editPost(path) {
			var token = getPat();
			if (!token) { setStatus($("pe-editor-status"), "请先验证 GitHub PAT", "is-error"); return; }
			state.isNew = false; state.editingPath = path;
			$("pe-editor-title").textContent = "编辑文章";
			setStatus($("pe-editor-foot-status"), "正在拉取文章内容...", "");
			try {
				var r = await fetch(API_CONTENT(path), { headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token } });
				if (!r.ok) { var e = await r.json().catch(function(){return{};}); throw new Error("拉取失败 " + r.status + "：" + (e.message || r.statusText)); }
				var file = await r.json();
				state.editingSha = file.sha;
				var raw = base64ToUtf8(file.content || "");
				var sp = splitFrontmatter(raw);
				var fm = parseFm(sp.fm);
				fillForm(fm, sp.body, path);
				state.originalTitle = fm.title || "";
				hideTitleWarn();
				setStatus($("pe-editor-foot-status"), "✅ 已载入，可编辑后保存", "is-ok");
			} catch (e) {
				setStatus($("pe-editor-foot-status"), "❌ " + e.message, "is-error");
			}
		}
		function fillForm(fm, body, path) {
			$("pe-f-title").value = fm.title || "";
			var parts = (path || "").split("/");
			$("pe-f-folder").value = parts.length > 2 ? parts[2] : "others";
			$("pe-f-slug").value = (parts[parts.length - 1] || "").replace(/\.md$/, "");
			$("pe-f-cat").value = fm.category || "";
			$("pe-f-desc").value = fm.description || "";
			$("pe-f-tags").value = Array.isArray(fm.tags) ? fm.tags.join(", ") : "";
			$("pe-f-pub").value = (fm.published || "").slice(0, 10);
			$("pe-f-upd").value = (fm.updated || fm.published || "").slice(0, 10);
			$("pe-f-pinned").checked = fm.pinned === true;
			$("pe-f-draft").checked = fm.draft === true;
			$("pe-f-body").value = body || "";
		}
		function clearForm() {
			["pe-f-title","pe-f-slug","pe-f-cat","pe-f-desc","pe-f-tags","pe-f-pub","pe-f-upd","pe-f-body"].forEach(function (id) { if ($(id)) $(id).value = ""; });
			$("pe-f-folder").value = "others";
			$("pe-f-pub").value = nowDate();
			$("pe-f-upd").value = nowDate();
			$("pe-f-pinned").checked = false;
			$("pe-f-draft").checked = false;
		}

		// ===== 标题变更提示 =====
		function onTitleInput() {
			if (state.isNew) { autoSlugFromTitle(); hideTitleWarn(); return; }
			var t = ($("pe-f-title").value || "").trim();
			if (state.originalTitle && t && t !== state.originalTitle) {
				showTitleWarn("⚠️ 标题已从「" + state.originalTitle + "」改为「" + t + "」，原图片目录 /文章/" + state.originalTitle + "/ 下的图片将失效。请重新上传，或手动把图床目录里的图片改名迁移。");
			} else {
				hideTitleWarn();
			}
		}
		function autoSlugFromTitle() {
			var t = ($("pe-f-title").value || "").trim();
			var s = slugify(t);
			if (t && !/[a-z0-9]/i.test(t)) $("pe-f-slug").value = s; // 中文标题给个 ASCII 兜底
		}
		function showTitleWarn(msg) { var w = $("pe-title-warn"); if (w) { w.textContent = msg; w.style.display = ""; } }
		function hideTitleWarn() { var w = $("pe-title-warn"); if (w) w.style.display = "none"; }

		// ===== 收集表单 =====
		function collectForm() {
			var title = ($("pe-f-title").value || "").trim();
			var folder = $("pe-f-folder").value || "others";
			var slug = ($("pe-f-slug").value || "").trim() || slugify(title);
			var tags = ($("pe-f-tags").value || "").split(",").map(function (s) { return s.trim(); }).filter(Boolean);
			var fm = {
				title: title,
				published: ($("pe-f-pub").value || nowDate()).slice(0, 10),
				updated: ($("pe-f-upd").value || nowDate()).slice(0, 10),
				description: $("pe-f-desc").value || "",
				tags: tags,
				category: $("pe-f-cat").value || "",
				pinned: $("pe-f-pinned").checked,
				draft: $("pe-f-draft").checked,
			};
			var body = $("pe-f-body").value || "";
			return { fm: fm, body: body, folder: folder, slug: slug, path: "src/content/posts/" + folder + "/" + slug + ".md" };
		}

		// ===== 保存 =====
		async function saveRemote() {
			var token = getPat();
			if (!token) { setStatus($("pe-editor-foot-status"), "请先验证 GitHub PAT", "is-error"); return; }
			if (state.saving) return;
			state.saving = true;
			$("pe-editor-save").disabled = true;
			try {
				var c = collectForm();
				if (!c.fm.title) throw new Error("标题不能为空");
				var content = utf8ToBase64(buildMarkdown(c.fm, c.body));
				var pathChanged = !state.isNew && c.path !== state.editingPath;
				if (state.isNew) {
					// 新建：直接 PUT
					var r = await fetch(API_CONTENT(c.path), {
						method: "PUT",
						headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token, "Content-Type": "application/json" },
						body: JSON.stringify({ message: "feat(post): create " + c.slug + " via web editor", content: content, branch: "main" }),
					});
					if (!r.ok) { var e = await r.json().catch(function(){return{};}); throw new Error("创建失败 " + r.status + "：" + (e.message || r.statusText)); }
				} else if (pathChanged) {
					// 路径变更：删旧 + 建新
					var rd = await fetch(API_CONTENT(state.editingPath), {
						method: "DELETE",
						headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token, "Content-Type": "application/json" },
						body: JSON.stringify({ message: "chore(post): move " + state.editingPath + " -> " + c.path, sha: state.editingSha, branch: "main" }),
					});
					if (!rd.ok) { var ed = await rd.json().catch(function(){return{};}); throw new Error("移动-删除旧文件失败 " + rd.status + "：" + (ed.message || rd.statusText)); }
					var rn = await fetch(API_CONTENT(c.path), {
						method: "PUT",
						headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token, "Content-Type": "application/json" },
						body: JSON.stringify({ message: "chore(post): move to " + c.path, content: content, branch: "main" }),
					});
					if (!rn.ok) { var en = await rn.json().catch(function(){return{};}); throw new Error("移动-创建新文件失败 " + rn.status + "：" + (en.message || rn.statusText)); }
				} else {
					// 原地更新：PUT 带 sha（先刷新 sha 防冲突）
					var r1 = await fetch(API_CONTENT(state.editingPath), { headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token } });
					if (!r1.ok) { var e1 = await r1.json().catch(function(){return{};}); throw new Error("拉取 sha 失败 " + r1.status + "：" + (e1.message || r1.statusText)); }
					var latestSha = (await r1.json()).sha;
					var r2 = await fetch(API_CONTENT(state.editingPath), {
						method: "PUT",
						headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token, "Content-Type": "application/json" },
						body: JSON.stringify({ message: "update(post): " + c.slug + " via web editor", content: content, sha: latestSha, branch: "main" }),
					});
					if (!r2.ok) { var e2 = await r2.json().catch(function(){return{};}); throw new Error("保存失败 " + r2.status + "：" + (e2.message || r2.statusText)); }
				}
				state.editingPath = c.path; state.isNew = false; state.originalTitle = c.fm.title;
				hideTitleWarn();
				setStatus($("pe-editor-foot-status"), "✅ 已保存！部署约 1 分钟后可见", "is-ok");
				var commits = $("pe-editor-commits"); if (commits) commits.style.display = "";
				// 刷新列表种子（本地更新，无需等部署）
				refreshLocalPost(c);
			} catch (e) {
				setStatus($("pe-editor-foot-status"), "❌ " + e.message, "is-error");
			} finally {
				state.saving = false;
				$("pe-editor-save").disabled = false;
			}
		}
		function refreshLocalPost(c) {
			var idx = state.posts.findIndex(function (p) { return p.path === c.path; });
			var item = { path: c.path, folder: c.folder, slug: c.slug, title: c.fm.title, sha: state.editingSha || "local", published: c.fm.published, pinned: c.fm.pinned, draft: c.fm.draft };
			if (idx >= 0) state.posts[idx] = item; else state.posts.unshift(item);
			renderList();
		}

		// ===== 删除 =====
		async function deletePost(path) {
			var token = getPat();
			if (!token) { setStatus($("pe-editor-status"), "请先验证 GitHub PAT", "is-error"); return; }
			if (!confirm("确定删除 " + path + " ？此操作不可撤销。")) return;
			try {
				// 先取 sha
				var r0 = await fetch(API_CONTENT(path), { headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token } });
				if (!r0.ok) { var e0 = await r0.json().catch(function(){return{};}); throw new Error("拉取失败 " + r0.status + "：" + (e0.message || r0.statusText)); }
				var sha = (await r0.json()).sha;
				var r = await fetch(API_CONTENT(path), {
					method: "DELETE",
					headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token, "Content-Type": "application/json" },
					body: JSON.stringify({ message: "delete(post): " + path + " via web editor", sha: sha, branch: "main" }),
				});
				if (!r.ok) { var e = await r.json().catch(function(){return{};}); throw new Error("删除失败 " + r.status + "：" + (e.message || r.statusText)); }
				state.posts = state.posts.filter(function (p) { return p.path !== path; });
				renderList();
				setStatus($("pe-editor-status"), "✅ 已删除 " + path, "is-ok");
			} catch (e) {
				setStatus($("pe-editor-status"), "❌ " + e.message, "is-error");
			}
		}

		// ===== 事件绑定 =====
		function bind() {
			$("pe-open-editor")?.addEventListener("click", function () { state.editingPath = null; openEditor(null); });
			$("pe-editor-close")?.addEventListener("click", closeEditor);
			$("pe-editor-cancel")?.addEventListener("click", closeEditor);
			$("pe-editor")?.addEventListener("click", function (e) { if (e.target === $("pe-editor")) closeEditor(); });
			$("pe-editor")?.addEventListener("cancel", function (e) { e.preventDefault(); closeEditor(); });

			$("pe-editor-pat")?.addEventListener("input", function () {
				if (sessionStorage.getItem(PAT_STORAGE_KEY)) { sessionStorage.removeItem(PAT_STORAGE_KEY); renderSessionState(); }
			});
			$("pe-editor-pat-toggle")?.addEventListener("click", function () {
				var inp = $("pe-editor-pat"); if (!inp) return; inp.type = inp.type === "password" ? "text" : "password";
			});
			$("pe-editor-pat-validate")?.addEventListener("click", async function () {
				var inp = $("pe-editor-pat");
				if (!inp || !inp.value.trim()) { setStatus($("pe-editor-status"), "请先填写 GitHub PAT", "is-error"); return; }
				this.disabled = true; setStatus($("pe-editor-status"), "正在校验令牌...", "");
				try { await validatePat(inp.value.trim()); setPat(inp.value.trim()); setStatus($("pe-editor-status"), "✓ 令牌有效，本次浏览期间免重复输入", "is-ok"); renderSessionState(); }
				catch (e) { setStatus($("pe-editor-status"), "✗ " + e.message, "is-error"); }
				finally { this.disabled = false; }
			});
			$("pe-editor-pat-clear")?.addEventListener("click", function () {
				if (!confirm("确定退出本次浏览会话（清除已验证的令牌）？")) return;
				setPat(""); var inp = $("pe-editor-pat"); if (inp) inp.value = "";
				setStatus($("pe-editor-status"), "已退出会话，下次需重新验证", "is-ok"); renderSessionState();
			});
			$("pe-editor-load")?.addEventListener("click", loadRemote);
			$("pe-editor-save")?.addEventListener("click", saveRemote);
			$("pe-f-title")?.addEventListener("input", onTitleInput);
			$("pe-img-pick")?.addEventListener("click", function () { $("pe-img-file")?.click(); });
			$("pe-img-file")?.addEventListener("change", handleImgUpload);

			// 列表委托
			var listEl = $("pe-root").querySelector("[data-pe-list]");
			listEl?.addEventListener("click", function (e) {
				var t = e.target;
				var editPath = t.getAttribute && t.getAttribute("data-pe-edit");
				var delPath = t.getAttribute && t.getAttribute("data-pe-del");
				if (editPath) { openEditor(editPath); }
				else if (delPath) { deletePost(delPath); }
			});

			// 注入种子
			try { state.seed = window.__peSeed || []; } catch (_e) {}
		}
		function closeEditor() {
			var dlg = $("pe-editor");
			if (!dlg) return;
			if (typeof dlg.close === "function") dlg.close(); else dlg.removeAttribute("open");
		}

		// 初始化：用服务端种子填充列表
		function init() {
			try {
				state.seed = window.__peSeed || [];
				state.posts = (window.__peSeed || []).map(function (s) {
					return { path: s.path, folder: s.folder, slug: s.slug, title: s.title, published: s.published, pinned: s.pinned, draft: s.draft, sha: "" };
				});
			} catch (_e) { state.posts = []; }
			renderList();
		}
		init();
		bind();
	})();
</script>

<script is:inline define:vars={{ seed: postsIndex }}>
	window.__peSeed = seed;
</script>
