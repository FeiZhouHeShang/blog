---
import Icon from "@components/common/Icon.astro";
import PhotoCard from "@/components/pages/gallery/PhotoCard.svelte";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LeftSidebar from "@/components/layout/LeftSidebar.astro";
import RightSidebar from "@/components/layout/RightSidebar.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";
import "@/styles/pages/gallery.css";

// 检查页面是否启用
if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

export function getStaticPaths() {
	return galleryConfig.albums.map((album) => ({
		params: { album: album.id },
	}));
}

const { album: albumId } = Astro.params;
const albumMeta = galleryConfig.albums.find((a) => a.id === albumId);

if (!albumMeta) {
	return Astro.redirect("/404/");
}

const photos = scanAlbumPhotos(albumMeta.id);
const cover = getAlbumCover(albumMeta, photos);
---

<MainGridLayout title={albumMeta.name} description={albumMeta.description || ""}>
  <LeftSidebar slot="sidebar-left" />
  <RightSidebar slot="sidebar-right" />
  <!-- 相册封面横幅 -->
  <div class="w-full rounded-(--radius-large) overflow-hidden relative">
    {cover ? (
      <div class="relative w-full aspect-[3/1] min-h-[200px] max-h-[360px]">
        <img
          src={cover}
          alt={albumMeta.name}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />
        <!-- 返回按钮 -->
        <a
          href={url("/gallery/")}
          class="absolute top-4 left-4 inline-flex items-center gap-1.5 text-sm text-white/90 hover:text-white bg-black/30 hover:bg-black/50 backdrop-blur-sm px-3 py-1.5 rounded-lg transition-colors"
        >
          <Icon name="material-symbols:arrow-back" class="text-base" />
          {i18n(I18nKey.galleryBackToAlbums)}
        </a>
        <!-- 封面上的信息 -->
        <div class="absolute bottom-0 left-0 right-0 p-6">
          <div class="text-2xl sm:text-3xl font-bold text-white mb-2 drop-shadow-lg">
            {albumMeta.name}
          </div>
          {albumMeta.description && (
            <p class="text-sm text-white/75 leading-relaxed mb-2 max-w-2xl line-clamp-2">
              {albumMeta.description}
            </p>
          )}
          <div class="flex items-center gap-4 text-sm text-white/80 flex-wrap">
            {albumMeta.date && (
              <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:calendar-today" class="text-sm" />
                {albumMeta.date}
              </span>
            )}
            {albumMeta.location && (
              <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:location-on" class="text-sm" />
                {albumMeta.location}
              </span>
            )}
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:photo-library" class="text-sm" />
              {photos.length} {i18n(I18nKey.galleryPhotos)}
            </span>
          </div>
          {albumMeta.tags && albumMeta.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-2.5">
              {albumMeta.tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="card-base px-6 py-4">
        <a
          href={url("/gallery/")}
          class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mb-3"
        >
          <Icon name="material-symbols:arrow-back" class="text-base" />
          {i18n(I18nKey.galleryBackToAlbums)}
        </a>
        <div class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          {albumMeta.name}
        </div>
        <div class="flex items-center gap-4 text-sm text-neutral-500 dark:text-neutral-400 mt-2 flex-wrap">
          {albumMeta.date && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:calendar-today" class="text-sm" />
              {albumMeta.date}
            </span>
          )}
          {albumMeta.location && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:location-on" class="text-sm" />
              {albumMeta.location}
            </span>
          )}
          <span>{photos.length} {i18n(I18nKey.galleryPhotos)}</span>
        </div>
      </div>
    )}
  </div>

  <!-- 瀑布流照片网格 -->
  <div class="w-full rounded-(--radius-large) overflow-hidden relative mt-4">
    <div class="card-base z-10 px-6 py-6 relative w-full">
      <!-- 视图切换：大图 / 小图（偏好持久化到 localStorage） -->
      <div class="gallery-view-toggle">
        <span class="gallery-view-toggle-label">
          <Icon name="material-symbols:grid-view" class="text-base" />
          视图
        </span>
        <div class="gallery-seg" role="group" aria-label="切换大图或小图视图">
          <button type="button" data-view-btn="large" class="is-active">
            <Icon name="material-symbols:photo-size-select-large" class="text-base" />
            大图
          </button>
          <button type="button" data-view-btn="small">
            <Icon name="material-symbols:photo-size-select-small" class="text-base" />
            小图
          </button>
        </div>
        <span class="gallery-view-hint hidden sm:inline">图片多时切小图翻页更快</span>
      </div>

      {photos.length > 0 ? (
        <div class="gallery-masonry" data-view="large">
          {photos.map((photo) => (
            <PhotoCard src={photo.src} type={photo.type} name={photo.name} albumId={albumMeta.id} client:visible />
          ))}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
          <Icon name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50" />
          <p class="text-lg">{i18n(I18nKey.galleryNoAlbums)}</p>
        </div>
      )}
    </div>
  </div>

  <!-- 样式已迁移至 src/styles/pages/gallery.css -->

  <!-- 大图 / 小图 视图切换（兼容 Swup 软导航，localStorage 记忆偏好） -->
  <script>
    function initGalleryViewToggle() {
      const masonry = document.querySelector(".gallery-masonry[data-view]");
      if (!masonry) return;
      const btns = Array.from(document.querySelectorAll("[data-view-btn]"));
      if (!btns.length) return;
      const KEY = "gallery-view";
      const apply = (mode) => {
        if (mode !== "large" && mode !== "small") mode = "large";
        masonry.setAttribute("data-view", mode);
        btns.forEach((b) =>
          b.classList.toggle("is-active", b.getAttribute("data-view-btn") === mode),
        );
      };
      // 先应用已保存偏好，避免每次进相册都回到默认
      apply(localStorage.getItem(KEY) || "large");
      btns.forEach((b) => {
        b.addEventListener("click", () => {
          const mode = b.getAttribute("data-view-btn");
          localStorage.setItem(KEY, mode);
          apply(mode);
        });
      });
    }
    document.addEventListener("astro:page-load", initGalleryViewToggle);
    initGalleryViewToggle();
  </script>
</MainGridLayout>
