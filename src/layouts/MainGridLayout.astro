---
import Live2DWidget from "@components/features/Live2DWidget.astro";
import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";

import {
	live2dModelConfig,
	navBarConfig,
	siteConfig,
	spineModelConfig,
} from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import Layout from "./Layout.astro";

import "@/styles/markdown.css";
import "@/styles/expressive-code.css";
import "@/styles/toc.css";
import "@/styles/collections.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCategory?: string;
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCategory,
	bannerPostMeta: _bannerPostMeta,
} = Astro.props;

const shouldRenderCategoryBar = !!siteConfig.categoryBar;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

// [关键词: sidebar-position] 根据命名插槽自动检测侧栏位置
//  - 页面通过 <slot name="sidebar-left" /> / <slot name="sidebar-right" /> 传入侧栏内容
//  - Astro.slots.has() 在构建时检测插槽是否有内容
//  - 自动设置 data-sidebar-position，CSS 据此切换三栏/两栏/单栏布局
// 想「给某个页面加/去掉侧栏」：在对应页面 .astro 里加/删 <LeftSidebar slot="sidebar-left" />
//   （见 src/pages/about.astro、list.astro 等）；位置（both/left/right/none）会自动算好。
// 想「改侧栏宽度/间距」：见 src/styles/layout/grid.css 的 --sidebar-width / --sidebar-gap。
// 注意：#main-grid 在 Swup 软导航容器之外，跳转时 data-sidebar-position 不会自动更新，
//   同步逻辑在 src/layouts/Layout.astro（[关键词: sidebar-position-sync]）。
const hasLeftSidebar = Astro.slots.has("sidebar-left");
const hasRightSidebar = Astro.slots.has("sidebar-right");
let sidebarPosition: "both" | "left" | "right" | "none";
if (hasLeftSidebar && hasRightSidebar) sidebarPosition = "both";
else if (hasLeftSidebar) sidebarPosition = "left";
else if (hasRightSidebar) sidebarPosition = "right";
else sidebarPosition = "none";

const navLinks = navBarConfig.links.map((item) => {
	if (typeof item === "number") return LinkPresets[item];
	return item;
});
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug}>
	<slot slot="head" name="head"></slot>

	<div
		id="top-row"
		class="z-50 pointer-events-none relative mx-auto"
		class:list={[
			"sticky top-0 left-0 right-0 z-80 pt-2.5",
			navbarWidthFull ? "w-full" : "w-full max-w-(--page-width) px-0 md:px-4",
		]}
	>
		<div id="navbar-wrapper" class="pointer-events-auto bg-transparent">
			<Navbar></Navbar>
		</div>
	</div>

	<NavMenuPanel links={navLinks} />

	<div class="relative w-full" id="main-grid-wrapper">
		<div class="mx-auto max-w-(--page-width) px-4 md:px-6" data-sidebar-position={sidebarPosition} id="main-grid">
			{/* [关键词: left-sidebar-dynamic] 左侧全局侧栏（命名插槽传入）
			   留空时由 CSS（grid.css 的 sidebar-hide 规则）自动隐藏 */}
			<div id="left-sidebar-dynamic">
				<slot name="sidebar-left" />
			</div>

			{/* [关键词: swup-container] 中间主内容区（默认插槽） */}
			<main id="swup-container" class="transition-swup-main" data-current-post-category={postCategory || ""}>
				{shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar title={title} postSlug={postSlug} postCategory={postCategory} /></div>}
				<h1 class="sr-only">{title}</h1>

				<div id="content-wrapper" class="onload-animation">
					<slot></slot>
				</div>
				<div class="footer onload-animation mt-16 pt-8 border-t">
					<Footer></Footer>
				</div>
			</main>

			{/* [关键词: right-sidebar-dynamic] 右侧全局侧栏（命名插槽传入） */}
			<div id="right-sidebar-dynamic">
				<slot name="sidebar-right" />
			</div>
		</div>

		{/* Spine / Live2D 是 position: fixed 装饰组件，放在 grid 容器外避免参与 grid auto-placement */}
		{spineModelConfig.enable && <SpineModel />}
		{live2dModelConfig.enable && <Live2DWidget config={live2dModelConfig} />}
	</div>
</Layout>