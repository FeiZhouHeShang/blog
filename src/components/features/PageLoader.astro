---
// 加载页：还原「居中动效 + 文本」形态，做轻量品牌适配。
// 文本改为打字机效果（循环状态短语，无站名/人名，避免 LOW），
// 并加均衡器装饰条避免单调。配色沿用博客品牌粉 #D44E7D。
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
---
<div
	id="page-loader"
	class:list={["page-loader", isHome ? "page-loader--visible" : "page-loader--hidden"]}
	role="status"
	aria-live="polite"
	aria-label="页面加载中"
	hidden={!isHome}
>
	<div class="page-loader__inner">
		<div class="page-loader__spinner" aria-hidden="true"></div>
		<div class="page-loader__type" aria-hidden="true">
			<span id="loader-type"></span><span class="page-loader__caret"></span>
		</div>
		<div class="page-loader__eq" aria-hidden="true">
			<i></i><i></i><i></i><i></i><i></i>
		</div>
	</div>
	<span class="page-loader__sr-only">Loading</span>
</div>

<script is:inline>
	(function () {
		var el = document.getElementById("loader-type");
		if (!el) return;
		var phrases = [
			"正在唤醒博客引擎",
			"加载主题与配色",
			"同步最新文章",
			"校准视觉特效",
		];
		var pi = 0,
			ci = 0,
			deleting = false;
		function tick() {
			var full = phrases[pi];
			if (!deleting) {
				ci++;
				el.textContent = full.slice(0, ci);
				if (ci === full.length) {
					deleting = true;
					return setTimeout(tick, 850);
				}
			} else {
				ci--;
				el.textContent = full.slice(0, ci);
				if (ci === 0) {
					deleting = false;
					pi = (pi + 1) % phrases.length;
				}
			}
			setTimeout(tick, deleting ? 34 : 78);
		}
		requestAnimationFrame(tick);
	})();
</script>

<script is:inline>
	// [兜底] 独立于外部控制器：最多 9s 强制隐藏加载页，杜绝「卡死进不去博客」。
	// 控制器成功隐藏后会派发 firefly:page-loader-hidden 事件，届时清除该计时器。
	(function () {
		var el = document.getElementById("page-loader");
		if (!el) return;
		var failsafe = setTimeout(function () {
			el.classList.add("page-loader--hidden");
			el.hidden = true;
			document.documentElement.classList.remove("is-page-loading");
			document.body && document.body.removeAttribute("aria-busy");
		}, 9000);
		document.addEventListener(
			"firefly:page-loader-hidden",
			function () {
				clearTimeout(failsafe);
			},
			{ once: true },
		);
	})();
</script>
