---
// 加载页：还原「居中动效 + 文本」的原版形态，仅做轻量品牌适配。
// 原版用作者图 feibi-loading.webp（已按需求移除），这里改为纯 CSS 转圈，
// 文本从 "Loading" 改为博客站名，主题色走博客品牌粉，避免原作者痕迹。
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const siteName = "非洲和尚"; // 与 homeConfig.displayName 保持一致
---
<div
	id="page-loader"
	class:list={["page-loader", isHome ? "page-loader--visible" : "page-loader--hidden"]}
	role="status"
	aria-live="polite"
	aria-label="页面加载中"
	hidden={!isHome}
>
	<div class="page-loader__inner">
		<div class="page-loader__spinner" aria-hidden="true"></div>
		<div class="page-loader__brand">{siteName}</div>
		<div class="page-loader__status">正在加载…</div>
	</div>
	<span class="page-loader__sr-only">Loading</span>
</div>
