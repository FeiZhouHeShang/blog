---
import { homeConfig } from "@/config/homeConfig";

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const avatar = homeConfig.avatar;
const siteName = homeConfig.displayName || "非洲和尚";
// 与 siteConfig.themeColor.hue 保持一致（青绿 165）
const hue = 165;
---

<div
	id="page-loader"
	class:list={["page-loader", isHome ? "page-loader--visible" : "page-loader--hidden"]}
	role="status"
	aria-live="polite"
	aria-label="页面加载中"
	hidden={!isHome}
	style={`--loader-hue: ${hue};`}
>
	<div class="page-loader__stage" aria-hidden="true">
		<div class="page-loader__halo"></div>
		<div class="page-loader__orb">
			<div class="page-loader__orb-core"></div>
		</div>
		<div class="page-loader__emblem">
			<img
				src={avatar}
				alt=""
				class="page-loader__avatar"
				width="120"
				height="120"
				decoding="async"
			/>
		</div>
	</div>

	<div class="page-loader__caption">
		<span class="page-loader__name">{siteName}</span>
		<span class="page-loader__dots" aria-hidden="true"><i></i><i></i><i></i></span>
	</div>

	<span class="page-loader__sr-only">Loading</span>
</div>
