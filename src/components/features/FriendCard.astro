---
export interface Props {
	title: string;
	href: string;
	imgurl: string;
	desc: string;
	tags?: string[];
}

const { title, href, imgurl, desc, tags = [] } = Astro.props;

// 类型标签：标明是博客还是文档（大写英文，配中性灰小字，与博客单色风格一致）
const tagLabels: Record<string, string> = {
	Blog: "BLOG",
	Docs: "DOCS",
};

const primaryTag = tags[0] || "Blog";
const tagLabel = tagLabels[primaryTag] || primaryTag.toUpperCase();

// 头像加载失败 / 骨架占位使用的首字（中文或英文皆可）
const initial = title.trim().slice(0, 1);

// 从 URL 提取 hostname 作为卡片底部展示（去掉 www. 前缀）
let hostname = "";
try {
	hostname = new URL(href).hostname.replace(/^www\./, "");
} catch {
	hostname = href;
}

// 除主类型外的额外 tags（如「技术 / 生活」），显示在卡片底部右侧
const extraTags = tags.slice(1);
---

<a
  class="friend-card-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  title={desc}
  aria-label={`${title} — ${desc}`}
>
  <!-- 顶部：类型标签 + 右上角外链箭头 -->
  <div class="friend-card-head">
    <span class="friend-card-tag">{tagLabel}</span>
    <svg class="friend-card-arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M5 11L11 5M11 5H6M11 5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>

  <!-- 头像（懒加载：data-src 由 friends.astro 的脚本在卡片可见时注入 src，
       避免 loading=lazy + display:none 在 Swup 导航后不触发加载） -->
  <div class="friend-card-avatar-wrap">
    <div class="friend-card-avatar" data-initial={initial}>
      <img
        alt={title}
        class="friend-card-avatar__img"
        data-src={imgurl}
      />
    </div>
  </div>

  <!-- 名字 -->
  <h3 class="friend-card-name">{title}</h3>

  <!-- 描述：3 行 clamp，可读字号 + 合适行高 -->
  <p class="friend-card-desc">{desc}</p>

  <!-- 底部：细分隔线 + 域名 + 额外标签 -->
  <div class="friend-card-foot">
    <span class="friend-card-url">{hostname}</span>
    {extraTags.length > 0 && (
      <span class="friend-card-tags">
        {extraTags.map((t) => <span>{t}</span>)}
      </span>
    )}
  </div>
</a>

<!-- 样式见 src/styles/components/friend-card.css -->