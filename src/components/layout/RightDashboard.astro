---
import Icon from "@components/common/Icon.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

// [关键词: right-dashboard] 右侧仪表盘 - 显示日历和最新文章
// 修改最新文章数量：搜索 dashboard-recent-count
// 修改日历：搜索 dashboard-calendar
// 主题同步：已使用 CSS 变量，自动适配亮/暗主题
const posts = await getSortedPosts();

// [关键词: dashboard-recent-count] 最新文章数量
const recentPosts = posts.slice(0, 5);

// [关键词: dashboard-calendar] 日历数据（自动计算当月）
const today = new Date();
const year = today.getFullYear();
const month = today.getMonth();
const firstDayOfMonth = new Date(year, month, 1).getDay();
const daysInMonth = new Date(year, month + 1, 0).getDate();
---

<aside class="right-dashboard">
	{/* 日历卡片 */}
	<div class="dash-card dash-calendar">
		<h3 class="dash-card__title">
			<Icon name="material-symbols:calendar-month-outline" class="dash-card__icon" />
			{year}年{month + 1}月
		</h3>
		<div class="dash-calendar__grid">
			{["日", "一", "二", "三", "四", "五", "六"].map((d) => (
				<span class="dash-calendar__weekday">{d}</span>
			))}
			{Array.from({ length: firstDayOfMonth }).map(() => (
				<span></span>
			))}
			{Array.from({ length: daysInMonth }).map((_, i) => {
				const day = i + 1;
				const isToday = day === today.getDate();
				return (
					<span class={`dash-calendar__day ${isToday ? "is-today" : ""}`}>{day}</span>
				);
			})}
		</div>
	</div>

	{/* 最新文章 */}
	<div class="dash-card dash-posts">
		<h3 class="dash-card__title">
			<Icon name="material-symbols:article-outline" class="dash-card__icon" />
			最新文章
		</h3>
		<ul class="dash-posts__list">
			{recentPosts.map((post) => (
				<li class="dash-posts__item">
					<a href={getPostUrlBySlug(post.id)} class="dash-posts__link">
						<span class="dash-posts__title">{post.data.title}</span>
					</a>
					<time class="dash-posts__date" datetime={post.data.published.toISOString()}>
						{post.data.published.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}
					</time>
				</li>
			))}
		</ul>
	</div>
</aside>

<style>
.right-dashboard {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	position: sticky;
	top: 80px;
	max-height: calc(100vh - 100px);
	overflow-y: auto;
}

.dash-card {
	background: var(--float-panel-bg);
	border: 1px solid var(--line-divider);
	border-radius: 12px;
	padding: 1.1rem;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

:root.dark .dash-card {
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.dash-card__title {
	display: flex;
	align-items: center;
	gap: 0.4rem;
	font-size: 0.95rem;
	font-weight: 600;
	color: var(--deep-text);
	margin: 0 0 0.85rem;
}

.dash-card__icon {
	font-size: 1.1rem;
	color: var(--primary);
}

/* 日历 */
.dash-calendar__grid {
	display: grid;
	grid-template-columns: repeat(7, 1fr);
	gap: 2px;
	text-align: center;
}

.dash-calendar__weekday {
	font-size: 0.7rem;
	font-weight: 600;
	color: var(--content-meta);
	padding: 0.2rem 0;
}

.dash-calendar__day {
	font-size: 0.75rem;
	padding: 0.25rem 0;
	border-radius: 6px;
	color: var(--deep-text);
	transition: background 0.15s;
}

.dash-calendar__day:hover {
	background: var(--btn-plain-bg-hover);
}

.dash-calendar__day.is-today {
	background: var(--primary);
	color: var(--page-bg);
	font-weight: 600;
}

/* 最新文章 */
.dash-posts__list {
	list-style: none;
	padding: 0;
	margin: 0;
}

.dash-posts__item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 0.5rem 0;
	border-bottom: 1px dashed var(--line-divider);
	gap: 0.5rem;
}

.dash-posts__item:last-child {
	border-bottom: none;
}

.dash-posts__link {
	text-decoration: none;
	color: var(--deep-text);
	flex: 1;
	min-width: 0;
}

.dash-posts__title {
	font-size: 0.8rem;
	font-weight: 500;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	display: block;
	transition: color 0.15s;
}

.dash-posts__link:hover .dash-posts__title {
	color: var(--primary);
}

.dash-posts__date {
	font-size: 0.7rem;
	color: var(--content-meta);
	flex-shrink: 0;
}
</style>