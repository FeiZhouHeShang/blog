---
import Icon from "@components/common/Icon.astro";
import { homeConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";

// [关键词: profile-card] 左侧个人信息卡片 - 显示头像、名字、统计数据、社交按钮
//
// 使用说明：
// - 头像：搜索 profile-avatar
// - 名字/显示名：修改 homeConfig.ts
// - 统计数据：自动从文章列表计算
// - 社交按钮：搜索 profile-social-links
// - QQ链接：搜索 nav-qq-link（在 link-presets.ts）
// - 主题同步：已使用 CSS 变量，自动适配亮/暗主题
const posts = await getSortedPosts();

// [关键词: profile-stats] 统计数据
const totalPosts = posts.length;
const totalTags = posts.length > 0 ? new Set(posts.flatMap(p => p.data.tags || [])).size : 0;
const totalCategories = posts.length > 0 ? new Set(posts.flatMap(p => p.data.category ? [p.data.category] : [])).size : 0;

// [关键词: profile-avatar] 头像路径
const avatarSrc = "/gallery/mxdl-2026/QQ.png";

// [关键词: profile-social-links] 社交按钮配置
// icon: 图标名称（访问 https://icones.js.org/ 查找）
// href: 链接地址
// label: 鼠标悬停提示文字
const qqNumber = "5563000";
const socialLinks = [
	{ icon: "simple-icons:qq", href: `tencent://message/?uin=${qqNumber}`, label: "QQ" },
	{ icon: "material-symbols:mail-outline", href: "mailto:5563000@qq.com", label: "邮箱" },
	{ icon: "material-symbols:rss-feed", href: "/rss.xml", label: "RSS" },
];
---

<aside class="profile-card">
	{/* [关键词: profile-avatar] 头像 - 修改路径见上方 avatarSrc */}
	<div class="profile-card__avatar">
		<img src={avatarSrc} alt={homeConfig.name} loading="lazy" />
	</div>

	{/* [关键词: profile-name] 名字 - 修改 homeConfig.displayName 或 homeConfig.name */}
	<h2 class="profile-card__name">{homeConfig.displayName || homeConfig.name}</h2>

	{/* [关键词: profile-stats] 统计数据 - 自动计算文章/标签/分类数量 */}
	<div class="profile-card__stats">
		<div class="profile-stat">
			<span class="profile-stat__value">{totalPosts}</span>
			<span class="profile-stat__label">文章</span>
		</div>
		<div class="profile-stat">
			<span class="profile-stat__value">{totalTags}</span>
			<span class="profile-stat__label">标签</span>
		</div>
		<div class="profile-stat">
			<span class="profile-stat__value">{totalCategories}</span>
			<span class="profile-stat__label">分类</span>
		</div>
	</div>

	{/* [关键词: profile-social-actions] 社交按钮 - 修改上方 socialLinks 数组 */}
	<div class="profile-card__actions">
		{socialLinks.map((link) => (
			<a
				class="profile-action"
				href={link.href}
				title={link.label}
				target={link.href.startsWith("http") ? "_blank" : undefined}
				rel="noopener noreferrer"
			>
				<Icon name={link.icon} class="profile-action__icon" />
			</a>
		))}
	</div>
</aside>

<style>
.profile-card {
	background: var(--float-panel-bg);
	border: 1px solid var(--line-divider);
	border-radius: 16px;
	padding: 1.5rem 1.25rem;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.85rem;
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
	text-align: center;
	/* [关键词: profile-card-sticky] 已移除 position: sticky，由父容器 .list-page-left 统一处理粘性定位 */
}

:root.dark .profile-card {
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
}

.profile-card__avatar {
	width: 100px;
	height: 100px;
	border-radius: 50%;
	padding: 3px;
	background: linear-gradient(135deg, var(--primary), var(--line-divider));
	flex-shrink: 0;
}

.profile-card__avatar img {
	width: 100%;
	height: 100%;
	border-radius: 50%;
	object-fit: cover;
	border: 3px solid var(--float-panel-bg);
}

.profile-card__name {
	font-size: 1.25rem;
	font-weight: 700;
	color: var(--deep-text);
	margin: 0;
}

.profile-card__stats {
	display: flex;
	justify-content: center;
	gap: 1.5rem;
	width: 100%;
	padding: 0.75rem 0;
	border-top: 1px solid var(--line-divider);
	border-bottom: 1px solid var(--line-divider);
}

.profile-stat {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.15rem;
}

.profile-stat__value {
	font-size: 1.25rem;
	font-weight: 700;
	color: var(--deep-text);
	line-height: 1;
}

.profile-stat__label {
	font-size: 0.7rem;
	color: var(--content-meta);
}

.profile-card__actions {
	display: flex;
	justify-content: center;
	gap: 0.5rem;
}

.profile-action {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 36px;
	height: 36px;
	border-radius: 8px;
	background: var(--btn-plain-bg-hover);
	color: var(--deep-text);
	text-decoration: none;
	transition: all 0.2s ease;
}

.profile-action:hover {
	background: var(--primary);
	color: var(--page-bg);
	transform: translateY(-2px);
}

.profile-action__icon {
	font-size: 1.1rem;
}
</style>