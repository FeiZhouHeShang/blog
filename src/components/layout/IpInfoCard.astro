---
import Icon from "@components/common/Icon.astro";

/**
 * [关键词: ip-info-card] 访客信息卡片 - 显示访客 IP 和地理信息
 * API 接口: https://my.ippure.com/v1/info
 * 在线卡片: https://my.ippure.com/v1/card
 * 官方站点: https://ippure.com
 *
 * 使用说明：
 * - 页面加载后自动获取访客信息并更新显示
 * - 点击按钮后加载 IPPure IP 卡片（图片形式）
 * - 点击卡片跳转至官方网站
 *
 * [关键词: ip-info-blogger] 博主位置配置（用于计算距离）
 * - lat: 博主纬度  lng: 博主经度
 * - 默认重庆（萌新大佬团队所在地），可修改为实际位置
 * - 留空则不显示距离信息
 */

// [关键词: ip-info-blogger-location] 博主位置 - 修改为你的实际坐标
const bloggerLocation = {
	lat: 29.563,
	lng: 106.551,
	city: "重庆",
};

// [关键词: ip-info-api] API 地址配置
const API_BASE = "https://my.ippure.com";
const INFO_API = `${API_BASE}/v1/info`;
const CARD_URL = `${API_BASE}/v1/card`;
const SITE_URL = "https://ippure.com";
---

<div class="ip-info-card" data-ip-info-card>
	<!-- [关键词: ip-info-title] 卡片标题 -->
	<h3 class="ip-info-card__title">
		<Icon name="material-symbols:person" class="ip-info-card__icon" />
		访客信息
	</h3>

	<!-- 默认提示内容（加载中/出错时显示） -->
	<div class="ip-info-card__hint" data-ip-hint>
		<p class="ip-info-card__welcome">欢迎访问本站 👋</p>
		<p class="ip-info-card__tip">正在获取访客信息...</p>
	</div>

	<!-- 信息详情区域（默认隐藏，获取成功后显示） -->
	<div class="ip-info-card__details" data-ip-details hidden>
		<!-- IP 地址 -->
		<div class="ip-info-row">
			<Icon name="material-symbols:api" class="ip-info-row__icon" />
			<span class="ip-info-row__label">IP 地址</span>
			<span class="ip-info-row__value" data-ip>--</span>
		</div>

		<!-- 地理位置 -->
		<div class="ip-info-row">
			<Icon name="material-symbols:location-on" class="ip-info-row__icon" />
			<span class="ip-info-row__label">地理位置</span>
			<span class="ip-info-row__value" data-location>--</span>
		</div>

		<!-- 与博主距离（可选） -->
		<div class="ip-info-row" data-distance-row hidden>
			<Icon name="material-symbols:arrow-outward-rounded" class="ip-info-row__icon" />
			<span class="ip-info-row__label">与博主距离</span>
			<span class="ip-info-row__value" data-distance>--</span>
		</div>

		<!-- 运营商 -->
		<div class="ip-info-row">
			<Icon name="material-symbols:folder-rounded" class="ip-info-row__icon" />
			<span class="ip-info-row__label">运营商</span>
			<span class="ip-info-row__value" data-isp>--</span>
		</div>

		<!-- 操作系统 -->
		<div class="ip-info-row">
			<Icon name="material-symbols:description-rounded" class="ip-info-row__icon" />
			<span class="ip-info-row__label">操作系统</span>
			<span class="ip-info-row__value" data-os>--</span>
		</div>

		<!-- 浏览器 -->
		<div class="ip-info-row">
			<Icon name="material-symbols:info-outline-rounded" class="ip-info-row__icon" />
			<span class="ip-info-row__label">浏览器</span>
			<span class="ip-info-row__value" data-browser>--</span>
		</div>
	</div>

	<!-- [关键词: ip-info-card-toggle] 加载/展开按钮 -->
	<button class="ip-info-card__toggle" data-ip-card-toggle type="button">
		<Icon name="material-symbols:visibility-outline-rounded" class="ip-info-card__toggle-icon" />
		<span data-ip-card-toggle-text>查看我的 IP 信息卡</span>
	</button>

	<!-- [关键词: ip-info-card-embed] 嵌入 IPPure IP 信息卡片（默认隐藏，点击后展开） -->
	<div class="ip-info-card__embed" data-ip-card-embed hidden>
		<!-- [关键词: ip-info-card-img-wrapper] 图片容器 - 使用 img 加载卡片 -->
		<a
			class="ip-info-card__embed-link"
			href={SITE_URL}
			target="_blank"
			rel="noopener noreferrer"
			title="点击查看详细 IP 信息"
		>
			<!-- [关键词: ip-info-card-img] IP 卡片图片 - 动态加载 -->
			<img
				class="ip-info-card__embed-img"
				data-ip-card-img
				alt="IP 信息卡片"
			/>
		</a>
	</div>
</div>

<!-- [关键词: ip-info-card-script] 客户端脚本 - 获取访客信息 -->
<script is:inline define:vars={{ infoApi: INFO_API, bloggerLoc: bloggerLocation, cardUrl: CARD_URL, siteUrl: SITE_URL }}>
(function () {
	const card = document.querySelector("[data-ip-info-card]");
	if (!card || card.dataset.initialized) return;
	card.dataset.initialized = "true";

	const hintEl = card.querySelector("[data-ip-hint]");
	const detailsEl = card.querySelector("[data-ip-details]");
	const toggleBtn = card.querySelector("[data-ip-card-toggle]");
	const toggleText = card.querySelector("[data-ip-card-toggle-text]");
	const embedEl = card.querySelector("[data-ip-card-embed]");
	const cardImg = card.querySelector("[data-ip-card-img]");

	// [关键词: ip-info-card-toggle-click] 点击按钮加载/折叠卡片
	if (toggleBtn && embedEl) {
		toggleBtn.addEventListener("click", function () {
			if (embedEl.hidden) {
				// 展开：显示容器并加载图片
				embedEl.hidden = false;
				// 添加时间戳防止缓存
				if (cardImg && !cardImg.src) {
					cardImg.src = cardUrl + "?t=" + Date.now();
				}
				toggleText.textContent = "收起 IP 信息卡";
				toggleBtn.classList.add("is-active");
			} else {
				// 收起：隐藏容器
				embedEl.hidden = true;
				toggleText.textContent = "查看我的 IP 信息卡";
				toggleBtn.classList.remove("is-active");
			}
		});
	}

	// [关键词: ip-info-card-img-load] 监听图片加载完成
	if (cardImg) {
		cardImg.addEventListener("load", function () {
			embedEl.classList.add("is-loaded");
		});
		cardImg.addEventListener("error", function () {
			embedEl.classList.add("is-error");
		});
	}

	const els = {
		ip: card.querySelector("[data-ip]"),
		location: card.querySelector("[data-location]"),
		distance: card.querySelector("[data-distance]"),
		distanceRow: card.querySelector("[data-distance-row]"),
		isp: card.querySelector("[data-isp]"),
		os: card.querySelector("[data-os]"),
		browser: card.querySelector("[data-browser]"),
	};

	async function fetchIpInfo() {
		try {
			const res = await fetch(infoApi);
			if (!res.ok) throw new Error("HTTP " + res.status);
			const data = await res.json();

			// 更新 IP
			if (els.ip) els.ip.textContent = data.ip || "未知";

			// 更新地理位置
			if (els.location) {
				const locParts = [];
				if (data.country) locParts.push(data.country);
				if (data.region && data.region !== data.city) locParts.push(data.region);
				if (data.city) locParts.push(data.city);
				els.location.textContent = locParts.length > 0
					? locParts.join(" · ")
					: "未知位置";
			}

			// 计算与博主的距离（km）
			if (bloggerLoc && bloggerLoc.lat && data.latitude) {
				const dist = haversine(
					bloggerLoc.lat, bloggerLoc.lng,
					parseFloat(data.latitude), parseFloat(data.longitude)
				);
				if (els.distance) {
					els.distance.textContent = formatDistance(dist);
				}
				if (els.distanceRow) els.distanceRow.hidden = false;
			}

			// 更新运营商
			if (els.isp) {
				els.isp.textContent = data.asOrganization || "未知";
			}

			// 解析 UserAgent 获取 OS 和浏览器
			const ua = data.userAgent || navigator.userAgent || "";
			if (els.os) els.os.textContent = detectOS(ua);
			if (els.browser) els.browser.textContent = detectBrowser(ua);

			// 切换显示
			if (hintEl) hintEl.hidden = true;
			if (detailsEl) detailsEl.hidden = false;
		} catch (err) {
			// 出错时保持提示信息
			if (hintEl) {
				const tip = hintEl.querySelector(".ip-info-card__tip");
				if (tip) tip.textContent = "无法获取访客信息";
			}
			console.warn("[IpInfoCard] API error:", err);
		}
	}

	// Haversine 公式计算两点间距离（km）
	function haversine(lat1, lon1, lat2, lon2) {
		const R = 6371;
		const dLat = (lat2 - lat1) * Math.PI / 180;
		const dLon = (lon2 - lon1) * Math.PI / 180;
		const a = Math.sin(dLat / 2) ** 2 +
			Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
			Math.sin(dLon / 2) ** 2;
		const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
		return R * c;
	}

	function formatDistance(km) {
		if (km < 1) return Math.round(km * 1000) + " 米";
		if (km < 100) return km.toFixed(1) + " 公里";
		return Math.round(km) + " 公里";
	}

	function detectOS(ua) {
		if (/Windows NT 10/.test(ua)) return "Windows 10/11";
		if (/Windows NT 6\.3/.test(ua)) return "Windows 8.1";
		if (/Windows NT 6\.2/.test(ua)) return "Windows 8";
		if (/Windows NT 6\.1/.test(ua)) return "Windows 7";
		if (/Windows/.test(ua)) return "Windows";
		if (/Mac OS X/.test(ua)) return "macOS";
		if (/Android/.test(ua)) return "Android";
		if (/iPhone|iPad|iPod/.test(ua)) return "iOS";
		if (/Linux/.test(ua)) return "Linux";
		return "未知";
	}

	function detectBrowser(ua) {
		if (/Edg\//.test(ua)) return "Edge";
		if (/OPR\//.test(ua) || /Opera/.test(ua)) return "Opera";
		if (/Chrome\//.test(ua)) return "Chrome";
		if (/Firefox\//.test(ua)) return "Firefox";
		if (/Safari\//.test(ua)) return "Safari";
		return "未知";
	}

	fetchIpInfo();
})();
</script>

<style>
.ip-info-card {
	background: var(--float-panel-bg);
	border: 1px solid var(--line-divider);
	border-radius: 16px;
	padding: 1.25rem;
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

:root.dark .ip-info-card {
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
}

.ip-info-card__title {
	display: flex;
	align-items: center;
	gap: 0.4rem;
	font-size: 0.95rem;
	font-weight: 600;
	color: var(--deep-text);
	margin: 0 0 0.75rem;
}

.ip-info-card__icon {
	font-size: 1.1rem;
	color: var(--primary);
}

/* 提示区域 */
.ip-info-card__hint {
	text-align: center;
	padding: 0.5rem 0;
}

.ip-info-card__welcome {
	font-size: 0.85rem;
	color: var(--deep-text);
	margin: 0 0 0.25rem;
}

.ip-info-card__tip {
	font-size: 0.75rem;
	color: var(--content-meta);
	margin: 0;
}

/* 详情区域 */
.ip-info-card__details {
	display: flex;
	flex-direction: column;
	gap: 0.4rem;
}

.ip-info-row {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	font-size: 0.8rem;
	padding: 0.25rem 0;
	border-bottom: 1px dashed var(--line-divider);
}

.ip-info-row:last-of-type {
	border-bottom: none;
}

.ip-info-row__icon {
	font-size: 0.95rem;
	color: var(--primary);
	flex-shrink: 0;
}

.ip-info-row__label {
	color: var(--content-meta);
	flex-shrink: 0;
	width: 68px;
}

.ip-info-row__value {
	color: var(--deep-text);
	flex: 1;
	text-align: right;
	word-break: break-all;
}

/* [关键词: ip-info-card-toggle] 加载/展开按钮 */
.ip-info-card__toggle {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	width: 100%;
	margin-top: 0.75rem;
	padding: 0.5rem 1rem;
	background: var(--primary);
	color: #fff;
	border: none;
	border-radius: 10px;
	font-size: 0.85rem;
	font-weight: 500;
	cursor: pointer;
	transition: all 0.2s ease;
}

.ip-info-card__toggle:hover {
	opacity: 0.9;
	transform: translateY(-1px);
}

.ip-info-card__toggle.is-active {
	background: var(--line-divider);
	color: var(--deep-text);
}

.ip-info-card__toggle-icon {
	font-size: 1rem;
}

/* [关键词: ip-info-card-embed] 嵌入卡片容器 */
.ip-info-card__embed {
	margin-top: 0.75rem;
	border-radius: 12px;
	overflow: hidden;
	border: 1px solid var(--line-divider);
	background: var(--page-bg);
	max-width: 100%;
	transition: all 0.3s ease;
}

.ip-info-card__embed-link {
	display: block;
	text-decoration: none;
	cursor: pointer;
}

/* [关键词: ip-info-card-img] IP 卡片图片 */
.ip-info-card__embed-img {
	display: block;
	width: 100%;
	height: auto;
	border-radius: 11px;
	transition: opacity 0.3s ease;
	opacity: 0;
}

.ip-info-card__embed.is-loaded .ip-info-card__embed-img {
	opacity: 1;
}

.ip-info-card__embed:hover .ip-info-card__embed-img {
	opacity: 0.9;
}

/* 加载中状态 */
.ip-info-card__embed:not(.is-loaded)::before {
	content: "";
	display: block;
	width: 100%;
	height: 200px;
	background: var(--page-bg);
	background-image: linear-gradient(90deg, 
		var(--page-bg) 0%, 
		var(--line-divider) 50%, 
		var(--page-bg) 100%);
	background-size: 200% 100%;
	animation: loading 1.5s infinite;
}

.ip-info-card__embed.is-loaded::before {
	display: none;
}

@keyframes loading {
	0% { background-position: 200% 0; }
	100% { background-position: -200% 0; }
}
</style>
